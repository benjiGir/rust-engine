// Le livre de quêtes : un fil conducteur qui dit quoi viser, pas comment (voir
// games/voxel/src/quests.rs et docs/modding.md pour le format complet).
//
// - settings : la progression (Flexible ou Linear) et la forme (Circle, Square, RoundSquare,
//   Hexagon, Diamond, Pentagon) par défaut. Seulement ici, dans le fichier de core.
// - groups : les groupes de chapitres, dans l'ordre. Un mod peut y ranger ses chapitres.
// - chapters : un chapitre a des quêtes, placées sur un plan (x vers la droite, y vers le bas, une
//   case de grille chacune). `after` : les quêtes à finir d'abord ; `size` : 1 par défaut.
// - tasks : Item (avoir, `#groupe` accepté), Check (case à cocher), Break, Place, Kill, Dimension,
//   Biome, Structure, Depth, Level, Tier.
// - rewards : Item, Xp, Loot (une table de `loot` de ce fichier), Choice (un objet au choix).
//   Les récompenses se récupèrent à la main, et ne sont données qu'une fois.
// - Dans `text`, `{touche:inventory}` devient la touche choisie dans les options.
(
    settings: (progression: Flexible, shape: Circle),
    groups: [
        (id: "core:basics", title: "Les bases", icon: "workbench"),
        (id: "core:adventure", title: "Aventure", icon: "iron_sword"),
        (id: "core:machines", title: "Machines", icon: "piston"),
        (id: "core:mods", title: "Mods", icon: "guide"),
    ],
    // Des tirages pour les récompenses (`Loot("snacks")`) : `rolls` tirages, chacun choisit une
    // entrée selon son poids.
    loot: {
        "snacks": (rolls: (1, 2), entries: [
            (item: "bread", count: (1, 2), weight: 3),
            (item: "apple", count: (1, 3), weight: 3),
            (item: "baked_potato", weight: 1),
        ]),
    },
    chapters: [
        (
            id: "core:first_steps",
            group: "core:basics",
            title: "Premiers pas",
            icon: "oak_log",
            quests: [
                (
                    id: "core:first_steps/log",
                    title: "Un arbre, enfin",
                    subtitle: "Tout commence par du bois",
                    text: "Frappe un tronc en gardant le clic gauche enfoncé : une bûche vaut mieux que mille idées.",
                    x: 0.0, y: 0.0, shape: Hexagon, size: 2.0,
                    tasks: [Item(item: "#logs", count: 1)],
                    rewards: [Item(item: "bread", count: 2), Xp(5)],
                ),
                (
                    id: "core:first_steps/planks",
                    title: "Des planches",
                    text: "Dans la petite grille 2 × 2 de ton inventaire ({touche:inventory}), une bûche donne quatre planches.",
                    x: 2.5, y: 0.0,
                    after: ["core:first_steps/log"],
                    tasks: [Item(item: "#planks", count: 4)],
                    rewards: [Xp(5)],
                    guide: "core:wood_and_crafting",
                ),
                (
                    id: "core:first_steps/workbench",
                    title: "Un plan de travail",
                    text: "Quatre planches en carré font un établi. Pose-le au sol : un clic droit ouvre sa grille 3 × 3, où se fabrique la plupart des objets.",
                    x: 4.5, y: 0.0, shape: Square,
                    after: ["core:first_steps/planks"],
                    tasks: [Item(item: "workbench")],
                    rewards: [Item(item: "torch", count: 4), Xp(5)],
                    guide: "core:wood_and_crafting",
                ),
                (
                    id: "core:first_steps/pickaxe",
                    title: "De quoi creuser",
                    text: "Sur l'établi : trois planches en rangée, et deux bâtons l'un sous l'autre au milieu. Deux planches l'une sur l'autre donnent des bâtons.",
                    x: 6.5, y: 0.0, shape: RoundSquare,
                    after: ["core:first_steps/workbench"],
                    tasks: [Item(item: "wooden_pickaxe")],
                    rewards: [Item(item: "bread", count: 2), Xp(10)],
                    guide: "core:tools",
                ),
                (
                    id: "core:first_steps/read_guide",
                    icon: "guide",
                    title: "Lire le guide",
                    subtitle: "Un clic droit, un livre",
                    text: "Le Guide du voyageur explique les bases, chapitre par chapitre. Ouvre-le d'un clic droit, feuillette-le, puis coche cette case.",
                    x: 0.0, y: 2.5, shape: Diamond,
                    tasks: [Check],
                    rewards: [Xp(5)],
                    guide: "core:first_steps",
                ),
                (
                    id: "core:first_steps/torch",
                    title: "Chasser le noir",
                    text: "Une torche se fabrique avec du charbon (ou du charbon de bois) et un bâton : quatre torches d'un coup. Pose-en une d'un clic droit sur un bloc.",
                    x: 4.5, y: 2.5,
                    after: ["core:first_steps/read_guide"],
                    tasks: [Place(block: "torch", count: 1)],
                    rewards: [Xp(5)],
                    guide: "core:light_and_furnace",
                ),
                (
                    id: "core:first_steps/stone",
                    title: "Sous l'herbe",
                    text: "Sous l'herbe, la pierre. Avec une pioche en bois elle lâche des moellons : casses-en cinq blocs.",
                    x: 6.5, y: 2.5, shape: Pentagon,
                    after: ["core:first_steps/pickaxe"],
                    tasks: [Break(block: "stone", count: 5)],
                    rewards: [Item(item: "cobblestone", count: 8), Xp(10)],
                ),
                (
                    id: "core:first_steps/fight",
                    icon: "wooden_sword",
                    title: "Premier combat",
                    text: "Une créature hostile te poursuit et te blesse : frappe-la avant qu'elle ne te vienne dessus. Elle donne de l'expérience.",
                    x: 8.5, y: 1.25, size: 1.5, shape: Hexagon,
                    after: ["core:first_steps/pickaxe", "core:first_steps/torch"],
                    tasks: [Kill(count: 1)],
                    rewards: [Item(item: "bread", count: 3), Xp(10)],
                    guide: "core:adventure",
                ),
            ],
        ),
        (
            id: "core:tools",
            group: "core:basics",
            title: "Les outils",
            icon: "stone_pickaxe",
            quests: [
                (
                    id: "core:tools/cobble",
                    title: "Un tas de moellons",
                    subtitle: "La pierre, c'est solide",
                    text: "Une pioche, même en bois, suffit pour détacher la pierre en moellons. Rassembles-en une bonne réserve : huit pour un four, trois pour une pioche.",
                    x: 0.0, y: 3.4, shape: Pentagon, size: 1.5,
                    after: ["core:first_steps/stone"],
                    tasks: [Item(item: "cobblestone", count: 8)],
                    rewards: [Item(item: "torch", count: 4), Xp(5)],
                    guide: "core:tools",
                ),
                (
                    id: "core:tools/stone_pickaxe",
                    title: "Une pioche en pierre",
                    text: "Même recette que la pioche en bois, avec des moellons à la place des planches. C'est elle qui permet de prendre le cuivre et le fer.",
                    x: 2.5, y: 0.0, shape: RoundSquare,
                    after: ["core:tools/cobble"],
                    tasks: [Item(item: "stone_pickaxe")],
                    rewards: [Item(item: "bread", count: 2), Xp(10)],
                    guide: "core:tools",
                ),
                (
                    id: "core:tools/stone_axe",
                    title: "Une hache de pierre",
                    text: "Trois moellons et deux bâtons : un outil plus solide pour abattre les arbres.",
                    x: 2.5, y: 2.25, shape: Square,
                    after: ["core:tools/cobble"],
                    tasks: [Item(item: "stone_axe")],
                    rewards: [Xp(10)],
                ),
                (
                    id: "core:tools/stone_sword",
                    title: "De quoi se défendre",
                    text: "Deux moellons l'un sur l'autre et un bâton dessous. Mieux vaut l'avoir en main avant la nuit.",
                    x: 2.5, y: 4.5, shape: Diamond,
                    optional: true,
                    after: ["core:tools/cobble"],
                    tasks: [Item(item: "stone_sword")],
                    rewards: [Xp(5)],
                ),
                (
                    id: "core:tools/furnace",
                    title: "Un four",
                    text: "Huit moellons posés en anneau. Une fois posé, il cuit en haut ce qu'on lui donne, avec du combustible en bas.",
                    x: 2.5, y: 6.75, shape: Hexagon, size: 1.5,
                    after: ["core:tools/cobble"],
                    tasks: [Item(item: "furnace")],
                    rewards: [Item(item: "bread", count: 3), Xp(10)],
                    guide: "core:light_and_furnace",
                ),
                (
                    id: "core:tools/coal",
                    title: "Du combustible",
                    text: "Le charbon se trouve dans la pierre, entre les hauteurs 40 et 180. À défaut, cuis des bûches au four : elles donnent du charbon de bois. Il brûle 80 secondes.",
                    x: 5.0, y: 0.0,
                    after: ["core:tools/stone_pickaxe"],
                    tasks: [Item(item: "#coals", count: 4)],
                    rewards: [Item(item: "torch", count: 8), Xp(5)],
                    guide: "core:ores",
                ),
                (
                    id: "core:tools/copper",
                    title: "Un filon de cuivre",
                    text: "Le cuivre se cache entre les hauteurs 30 et 100 et demande une pioche en pierre. Chaque bloc lâche plusieurs morceaux de cuivre brut.",
                    x: 5.0, y: 2.25, shape: Hexagon,
                    after: ["core:tools/stone_pickaxe"],
                    tasks: [Break(block: "copper_ore", count: 3)],
                    rewards: [Xp(10)],
                    guide: "core:ores",
                ),
                (
                    id: "core:tools/glass",
                    title: "Du verre",
                    text: "Le sable cuit au four devient du verre. Garde-en deux : un bouton de la fiche les remet, et on te donne un petit quelque chose en échange.",
                    x: 5.0, y: 6.75,
                    optional: true,
                    after: ["core:tools/furnace"],
                    tasks: [Item(item: "glass", count: 2, consume: true)],
                    rewards: [Loot("snacks")],
                ),
                (
                    id: "core:tools/ingot",
                    title: "Le premier lingot",
                    subtitle: "Un métal pour de bon",
                    text: "Du cuivre brut en haut du four, du charbon en bas : dix secondes plus tard, un lingot. C'est le premier métal, et la porte des outils qui durent.",
                    x: 7.5, y: 3.4, shape: Hexagon, size: 2.0,
                    after: ["core:tools/furnace", "core:tools/coal", "core:tools/copper"],
                    tasks: [Item(item: "copper_ingot")],
                    rewards: [
                        Choice([(item: "bread", count: 4), (item: "torch", count: 12), (item: "coal", count: 4)]),
                        Xp(15),
                    ],
                    guide: "core:light_and_furnace",
                ),
                (
                    id: "core:tools/copper_pickaxe",
                    title: "Du cuivre au poing",
                    text: "Trois lingots en haut, deux bâtons dessous : une pioche en cuivre, qui dure plus longtemps que celle en pierre.",
                    x: 10.0, y: 3.4, shape: RoundSquare,
                    hidden: true,
                    after: ["core:tools/ingot"],
                    tasks: [Item(item: "copper_pickaxe")],
                    rewards: [Xp(10)],
                ),
            ],
        ),
        // ----- Les bases (suite) : le métal, la table, les profondeurs -----
        (
            id: "core:metal",
            group: "core:basics",
            title: "L'âge du métal",
            icon: "iron_ingot",
            quests: [
                (
                    id: "core:metal/ore",
                    title: "Un filon de fer",
                    text: "Le fer se cache entre les hauteurs 5 et 90 et se prend avec une pioche en pierre. Chaque bloc lâche du fer brut, que le four fond en lingots comme le cuivre.",
                    x: 0.0, y: 3.75, shape: Pentagon,
                    after: ["core:tools/ingot"],
                    tasks: [Break(block: "iron_ore", count: 3)],
                    rewards: [Item(item: "torch", count: 6), Xp(10)],
                    guide: "core:ores",
                ),
                (
                    id: "core:metal/ingot",
                    title: "Le métal des outils",
                    subtitle: "Du fer en lingots",
                    text: "Du fer brut en haut du four, du charbon en bas. Trois lingots font une pioche, huit un plastron : fais-en une petite réserve.",
                    x: 3.0, y: 3.75, shape: Hexagon, size: 2.0,
                    after: ["core:metal/ore"],
                    tasks: [Item(item: "iron_ingot", count: 3)],
                    rewards: [Item(item: "bread", count: 3), Xp(15)],
                    guide: "core:light_and_furnace",
                ),
                (
                    id: "core:metal/pickaxe",
                    title: "Une pioche en fer",
                    text: "Même recette que les autres : trois lingots en haut, deux bâtons dessous. Elle ouvre les minerais de niveau 3 : l'or, le cinabre, le saphir et le jade.",
                    x: 6.5, y: 0.0, shape: RoundSquare,
                    after: ["core:metal/ingot"],
                    tasks: [Item(item: "iron_pickaxe")],
                    rewards: [Item(item: "torch", count: 8), Xp(15)],
                    guide: "core:tools",
                ),
                (
                    id: "core:metal/chestplate",
                    title: "Un plastron",
                    text: "Huit lingots, en laissant vide le haut du milieu. C'est la pièce d'armure qui protège le plus ; le casque, les jambières et les bottes suivront.",
                    x: 6.5, y: 2.5, shape: Square,
                    after: ["core:metal/ingot"],
                    tasks: [Item(item: "iron_chestplate")],
                    rewards: [Item(item: "bread", count: 2), Xp(15)],
                    guide: "core:armor",
                ),
                (
                    id: "core:metal/bucket",
                    title: "Un seau",
                    text: "Trois lingots en V. Un clic droit sur de l'eau (ou de la lave) le remplit ; un clic droit sur un bloc en verse le contenu plus loin.",
                    x: 6.5, y: 5.0,
                    after: ["core:metal/ingot"],
                    tasks: [Item(item: "bucket")],
                    rewards: [Xp(10)],
                ),
                (
                    id: "core:metal/shears",
                    title: "Des cisailles",
                    text: "Deux lingots en diagonale. Avec elles, les feuilles, les herbes hautes, les fougères et les lianes se ramassent telles quelles.",
                    x: 6.5, y: 7.5, shape: Diamond,
                    after: ["core:metal/ingot"],
                    tasks: [Item(item: "shears")],
                    rewards: [Xp(10)],
                ),
                (
                    id: "core:metal/water_bucket",
                    title: "De l'eau dans la poche",
                    text: "Remplis ton seau dans un lac : l'eau que tu emportes se verse où tu veux, par exemple près d'un champ trop loin de l'eau.",
                    x: 9.0, y: 5.0,
                    optional: true,
                    after: ["core:metal/bucket"],
                    tasks: [Item(item: "water_bucket")],
                    rewards: [Loot("snacks")],
                ),
            ],
        ),
        (
            id: "core:food",
            group: "core:basics",
            title: "Se nourrir et s'installer",
            icon: "wheat",
            quests: [
                (
                    id: "core:food/hoe",
                    title: "Une houe",
                    text: "Deux planches côte à côte, et deux bâtons en colonne dessous. Un clic droit avec elle sur de l'herbe ou de la terre dégagée laboure le sol.",
                    x: 0.0, y: 0.0, shape: Square,
                    after: ["core:first_steps/workbench"],
                    tasks: [Item(item: "wooden_hoe")],
                    rewards: [Xp(5)],
                    guide: "core:food_and_farming",
                ),
                (
                    id: "core:food/seeds",
                    title: "Des graines",
                    text: "Casse des herbes hautes ou des fougères : elles lâchent parfois des graines de blé.",
                    x: 0.0, y: 5.0, shape: Diamond,
                    after: ["core:first_steps/workbench"],
                    tasks: [Item(item: "seeds", count: 3)],
                    rewards: [Xp(5)],
                    guide: "core:food_and_farming",
                ),
                (
                    id: "core:food/field",
                    title: "Un champ irrigué",
                    subtitle: "Du blé qui pousse tout seul",
                    text: "Laboure, sème, et garde de l'eau à 4 blocs au plus : sinon la terre sèche et redevient de la terre. Le blé ne se récolte que mûr.",
                    x: 3.5, y: 2.5, shape: Hexagon, size: 2.0,
                    after: ["core:food/hoe", "core:food/seeds"],
                    tasks: [Item(item: "wheat", count: 3)],
                    rewards: [Item(item: "bread", count: 2), Xp(15)],
                    guide: "core:food_and_farming",
                ),
                (
                    id: "core:food/bread",
                    title: "Du pain frais",
                    text: "Trois blés en ligne donnent un pain. Celui du départ ne compte pas : il faut en fabriquer un.",
                    x: 7.0, y: 0.0,
                    after: ["core:food/field"],
                    tasks: [Item(item: "bread", crafted: true)],
                    rewards: [Item(item: "seeds", count: 4), Xp(10)],
                ),
                (
                    id: "core:food/herd",
                    icon: "wheat",
                    title: "Un élevage",
                    text: "Donne du blé à deux vaches, moutons ou poules adultes proches l'un de l'autre : un petit naît. Les cochons préfèrent les carottes. Coche la case quand le premier arrive.",
                    x: 7.0, y: 5.0, shape: Pentagon,
                    after: ["core:food/field"],
                    tasks: [Check],
                    rewards: [Xp(20)],
                    guide: "core:food_and_farming",
                ),
                (
                    id: "core:food/roast",
                    title: "À la broche",
                    text: "Crue, la viande nourrit peu : le four la cuit en dix secondes. Les vaches donnent du bœuf, et du cuir dont tu auras besoin.",
                    x: 9.5, y: 7.5,
                    after: ["core:food/herd", "core:tools/furnace"],
                    tasks: [Item(item: "cooked_beef", count: 2)],
                    rewards: [Xp(10)],
                    guide: "core:food_and_farming",
                ),
                (
                    id: "core:food/bed",
                    title: "Un lit",
                    text: "Trois feuilles ou trois laines au-dessus de trois planches. Un clic droit dessus fixe ton point de réapparition ; la nuit, il fait dormir jusqu'au matin, sauf si des créatures rôdent près de toi.",
                    x: 10.0, y: 0.0, shape: RoundSquare,
                    after: ["core:food/bread"],
                    tasks: [Item(item: "bed")],
                    rewards: [Xp(10)],
                    guide: "core:food_and_farming",
                ),
                (
                    id: "core:food/chest",
                    title: "Un coffre",
                    text: "Huit planches en anneau. En le regardant, tu vois un aperçu de son contenu : ton premier rangement.",
                    x: 12.5, y: 0.0, shape: Square,
                    after: ["core:food/bed"],
                    tasks: [Item(item: "chest")],
                    rewards: [Xp(10)],
                    guide: "core:storage",
                ),
                (
                    id: "core:food/backpack",
                    title: "Un sac à dos",
                    subtitle: "Le coffre qui te suit",
                    text: "Un coffre entouré de sept cuirs. {touche:backpack} ouvre le premier sac de ton inventaire : son contenu voyage avec toi.",
                    x: 12.5, y: 5.0, shape: Hexagon, size: 1.5,
                    after: ["core:food/chest", "core:food/herd"],
                    tasks: [Item(item: "backpack_leather")],
                    rewards: [Item(item: "bread", count: 3), Xp(15)],
                    guide: "core:storage",
                ),
            ],
        ),
        (
            id: "core:depths",
            group: "core:basics",
            title: "Les profondeurs",
            icon: "sapphire",
            quests: [
                (
                    id: "core:depths/descend",
                    icon: "torch",
                    title: "Plus bas",
                    subtitle: "Là où dorment les filons",
                    text: "Sous la hauteur 20 se trouvent le cinabre et le saphir ; l'or commence dès 36. Emporte des torches, du pain et de quoi te défendre : c'est sombre, et les créatures sortent dans le noir.",
                    x: 0.0, y: 3.75, shape: Pentagon, size: 1.5,
                    after: ["core:metal/pickaxe"],
                    tasks: [Depth(20)],
                    rewards: [Item(item: "torch", count: 8), Xp(15)],
                    guide: "core:ores",
                ),
                (
                    id: "core:depths/gold",
                    title: "De l'or",
                    text: "Il se prend avec une pioche en fer, entre les hauteurs 2 et 36, et fond comme les autres minerais. Les rails accélérateurs et la table de réforge en demandent.",
                    x: 3.0, y: 0.0,
                    after: ["core:depths/descend"],
                    tasks: [Item(item: "gold_ingot", count: 2)],
                    rewards: [Xp(15)],
                    guide: "core:ores",
                ),
                (
                    id: "core:depths/malachite",
                    title: "Une pierre verte",
                    text: "La malachite se trouve entre les hauteurs 5 et 40 ; chaque bloc en lâche plusieurs morceaux. Un cactus cuit au four en donne aussi.",
                    x: 3.0, y: 2.5, shape: Diamond,
                    optional: true,
                    after: ["core:depths/descend"],
                    tasks: [Item(item: "malachite", count: 4)],
                    rewards: [Xp(10)],
                ),
                (
                    id: "core:depths/cinnabar",
                    title: "De la poudre de cinabre",
                    text: "Entre les hauteurs 2 et 20, avec une pioche en fer. Chaque bloc lâche quatre ou cinq poudres : le fil, l'inverseur, le piston et les rails spéciaux en demandent.",
                    x: 3.0, y: 5.0, shape: Hexagon,
                    after: ["core:depths/descend"],
                    tasks: [Item(item: "cinnabar_dust", count: 4)],
                    rewards: [Xp(15)],
                    guide: "core:ores",
                ),
                (
                    id: "core:depths/sapphire",
                    title: "Un saphir",
                    subtitle: "Le plus rare",
                    text: "Entre les hauteurs 2 et 16, un seul saphir par bloc, et peu de blocs : prends ton temps. La table d'enchantement en demande deux.",
                    x: 3.0, y: 7.5, shape: Diamond,
                    after: ["core:depths/descend"],
                    tasks: [Item(item: "sapphire", count: 2)],
                    rewards: [Xp(20)],
                    guide: "core:ores",
                ),
                (
                    id: "core:depths/sapphire_pickaxe",
                    title: "Une pioche en saphir",
                    subtitle: "Le niveau 4",
                    text: "Trois saphirs en haut, deux bâtons dessous : l'outil le plus haut du jeu de base.",
                    x: 6.5, y: 7.5, shape: Hexagon, size: 2.0,
                    after: ["core:depths/sapphire"],
                    tasks: [Item(item: "sapphire_pickaxe")],
                    rewards: [Item(item: "torch", count: 12), Xp(30)],
                    guide: "core:tools",
                ),
            ],
        ),
        // ----- Aventure -----
        (
            id: "core:combat",
            group: "core:adventure",
            title: "Le combat",
            icon: "iron_sword",
            quests: [
                (
                    id: "core:combat/sword",
                    title: "Une épée en fer",
                    text: "Deux lingots l'un sur l'autre et un bâton dessous. Elle frappe plus fort que celle en pierre, et pour longtemps.",
                    x: 0.0, y: 3.75, shape: Diamond,
                    after: ["core:first_steps/fight", "core:metal/ingot"],
                    tasks: [Item(item: "iron_sword")],
                    rewards: [Item(item: "bread", count: 3), Xp(15)],
                    guide: "core:adventure",
                ),
                (
                    id: "core:combat/prowler",
                    icon: "shadow_dust",
                    title: "Les rôdeurs",
                    text: "Ils sortent dans le noir : la nuit, et dans les grottes. Ils lâchent parfois de la poussière d'ombre. Frappe le premier et recule si besoin.",
                    x: 3.0, y: 0.0,
                    after: ["core:combat/sword"],
                    tasks: [Kill(creature: "core:prowler", count: 3)],
                    rewards: [Item(item: "torch", count: 8), Xp(15)],
                ),
                (
                    id: "core:combat/spitter",
                    icon: "spores",
                    title: "Les cracheurs de spores",
                    text: "Ils lancent leurs projectiles de loin : approche vite, ou par un angle mort. Ils lâchent des spores, utiles à l'alchimie.",
