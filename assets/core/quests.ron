// Le livre de quêtes : un fil conducteur qui dit quoi viser, pas comment (voir
// games/voxel/src/quests.rs et docs/modding.md pour le format complet).
//
// - settings : la progression (Flexible ou Linear) et la forme (Circle, Square, RoundSquare,
//   Hexagon, Diamond, Pentagon) par défaut. Seulement ici, dans le fichier de core.
// - groups : les groupes de chapitres, dans l'ordre. Un mod peut y ranger ses chapitres.
// - chapters : un chapitre a des quêtes, placées sur un plan (x vers la droite, y vers le bas, une
//   case de grille chacune). `after` : les quêtes à finir d'abord ; `size` : 1 par défaut.
// - tasks : Item (avoir, `#groupe` accepté), Check (case à cocher), Break, Place, Kill, Dimension,
//   Biome, Structure, Depth, Level, Tier.
// - rewards : Item, Xp, Loot (une table de `loot` de ce fichier), Choice (un objet au choix).
//   Les récompenses se récupèrent à la main, et ne sont données qu'une fois.
// - Dans `text`, `{touche:inventory}` devient la touche choisie dans les options.
(
    settings: (progression: Flexible, shape: Circle),
    groups: [
        (id: "core:basics", title: "Les bases", icon: "workbench"),
        (id: "core:adventure", title: "Aventure", icon: "iron_sword"),
        (id: "core:mods", title: "Mods", icon: "guide"),
    ],
    // Des tirages pour les récompenses (`Loot("snacks")`) : `rolls` tirages, chacun choisit une
    // entrée selon son poids.
    loot: {
        "snacks": (rolls: (1, 2), entries: [
            (item: "bread", count: (1, 2), weight: 3),
            (item: "apple", count: (1, 3), weight: 3),
            (item: "baked_potato", weight: 1),
        ]),
    },
    chapters: [
        (
            id: "core:first_steps",
            group: "core:basics",
            title: "Premiers pas",
            icon: "oak_log",
            quests: [
                (
                    id: "core:first_steps/log",
                    title: "Un arbre, enfin",
                    subtitle: "Tout commence par du bois",
                    text: "Frappe un tronc en gardant le clic gauche enfoncé : une bûche vaut mieux que mille idées.",
                    x: 0.0, y: 0.0, shape: Hexagon, size: 2.0,
                    tasks: [Item(item: "#logs", count: 1)],
                    rewards: [Item(item: "bread", count: 2), Xp(5)],
                ),
                (
                    id: "core:first_steps/planks",
                    title: "Des planches",
                    text: "Dans la petite grille 2 × 2 de ton inventaire ({touche:inventory}), une bûche donne quatre planches.",
                    x: 2.5, y: 0.0,
                    after: ["core:first_steps/log"],
                    tasks: [Item(item: "#planks", count: 4)],
                    rewards: [Xp(5)],
                    guide: "core:wood_and_crafting",
                ),
                (
                    id: "core:first_steps/workbench",
                    title: "Un plan de travail",
                    text: "Quatre planches en carré font un établi. Pose-le au sol : un clic droit ouvre sa grille 3 × 3, où se fabrique la plupart des objets.",
                    x: 4.5, y: 0.0, shape: Square,
                    after: ["core:first_steps/planks"],
                    tasks: [Item(item: "workbench")],
                    rewards: [Item(item: "torch", count: 4), Xp(5)],
                    guide: "core:wood_and_crafting",
                ),
                (
                    id: "core:first_steps/pickaxe",
                    title: "De quoi creuser",
                    text: "Sur l'établi : trois planches en rangée, et deux bâtons l'un sous l'autre au milieu. Deux planches l'une sur l'autre donnent des bâtons.",
                    x: 6.5, y: 0.0, shape: RoundSquare,
                    after: ["core:first_steps/workbench"],
                    tasks: [Item(item: "wooden_pickaxe")],
                    rewards: [Item(item: "bread", count: 2), Xp(10)],
                    guide: "core:tools",
                ),
                (
                    id: "core:first_steps/read_guide",
                    icon: "guide",
                    title: "Lire le guide",
                    subtitle: "Un clic droit, un livre",
                    text: "Le Guide du voyageur explique les bases, chapitre par chapitre. Ouvre-le d'un clic droit, feuillette-le, puis coche cette case.",
                    x: 0.0, y: 2.5, shape: Diamond,
                    tasks: [Check],
                    rewards: [Xp(5)],
                    guide: "core:first_steps",
                ),
                (
                    id: "core:first_steps/torch",
                    title: "Chasser le noir",
                    text: "Une torche se fabrique avec du charbon (ou du charbon de bois) et un bâton : quatre torches d'un coup. Pose-en une d'un clic droit sur un bloc.",
                    x: 4.5, y: 2.5,
                    after: ["core:first_steps/read_guide"],
                    tasks: [Place(block: "torch", count: 1)],
                    rewards: [Xp(5)],
                    guide: "core:light_and_furnace",
                ),
                (
                    id: "core:first_steps/stone",
                    title: "Sous l'herbe",
                    text: "Sous l'herbe, la pierre. Avec une pioche en bois elle lâche des moellons : casses-en cinq blocs.",
                    x: 6.5, y: 2.5, shape: Pentagon,
                    after: ["core:first_steps/pickaxe"],
                    tasks: [Break(block: "stone", count: 5)],
                    rewards: [Item(item: "cobblestone", count: 8), Xp(10)],
                ),
                (
                    id: "core:first_steps/fight",
                    icon: "wooden_sword",
                    title: "Premier combat",
                    text: "Une créature hostile te poursuit et te blesse : frappe-la avant qu'elle ne te vienne dessus. Elle donne de l'expérience.",
                    x: 8.5, y: 1.25, size: 1.5, shape: Hexagon,
                    after: ["core:first_steps/pickaxe", "core:first_steps/torch"],
                    tasks: [Kill(count: 1)],
                    rewards: [Item(item: "bread", count: 3), Xp(10)],
                    guide: "core:adventure",
                ),
            ],
        ),
        (
            id: "core:tools",
            group: "core:basics",
            title: "Les outils",
            icon: "stone_pickaxe",
            quests: [
                (
                    id: "core:tools/cobble",
                    title: "Un tas de moellons",
                    subtitle: "La pierre, c'est solide",
                    text: "Une pioche, même en bois, suffit pour détacher la pierre en moellons. Rassembles-en une bonne réserve : huit pour un four, trois pour une pioche.",
                    x: 0.0, y: 3.4, shape: Pentagon, size: 1.5,
                    after: ["core:first_steps/stone"],
                    tasks: [Item(item: "cobblestone", count: 8)],
                    rewards: [Item(item: "torch", count: 4), Xp(5)],
                    guide: "core:tools",
                ),
                (
                    id: "core:tools/stone_pickaxe",
                    title: "Une pioche en pierre",
                    text: "Même recette que la pioche en bois, avec des moellons à la place des planches. C'est elle qui permet de prendre le cuivre et le fer.",
                    x: 2.5, y: 0.0, shape: RoundSquare,
                    after: ["core:tools/cobble"],
                    tasks: [Item(item: "stone_pickaxe")],
                    rewards: [Item(item: "bread", count: 2), Xp(10)],
                    guide: "core:tools",
                ),
                (
                    id: "core:tools/stone_axe",
                    title: "Une hache de pierre",
                    text: "Trois moellons et deux bâtons : un outil plus solide pour abattre les arbres.",
                    x: 2.5, y: 2.25, shape: Square,
                    after: ["core:tools/cobble"],
                    tasks: [Item(item: "stone_axe")],
                    rewards: [Xp(10)],
                ),
                (
                    id: "core:tools/stone_sword",
                    title: "De quoi se défendre",
                    text: "Deux moellons l'un sur l'autre et un bâton dessous. Mieux vaut l'avoir en main avant la nuit.",
                    x: 2.5, y: 4.5, shape: Diamond,
                    optional: true,
                    after: ["core:tools/cobble"],
                    tasks: [Item(item: "stone_sword")],
                    rewards: [Xp(5)],
                ),
                (
                    id: "core:tools/furnace",
                    title: "Un four",
                    text: "Huit moellons posés en anneau. Une fois posé, il cuit en haut ce qu'on lui donne, avec du combustible en bas.",
                    x: 2.5, y: 6.75, shape: Hexagon, size: 1.5,
                    after: ["core:tools/cobble"],
                    tasks: [Item(item: "furnace")],
                    rewards: [Item(item: "bread", count: 3), Xp(10)],
                    guide: "core:light_and_furnace",
                ),
                (
                    id: "core:tools/coal",
                    title: "Du combustible",
                    text: "Le charbon se trouve dans la pierre, entre les hauteurs 40 et 180. À défaut, cuis des bûches au four : elles donnent du charbon de bois. Il brûle 80 secondes.",
                    x: 5.0, y: 0.0,
                    after: ["core:tools/stone_pickaxe"],
                    tasks: [Item(item: "#coals", count: 4)],
                    rewards: [Item(item: "torch", count: 8), Xp(5)],
                    guide: "core:ores",
                ),
                (
                    id: "core:tools/copper",
                    title: "Un filon de cuivre",
                    text: "Le cuivre se cache entre les hauteurs 30 et 100 et demande une pioche en pierre. Chaque bloc lâche plusieurs morceaux de cuivre brut.",
                    x: 5.0, y: 2.25, shape: Hexagon,
                    after: ["core:tools/stone_pickaxe"],
                    tasks: [Break(block: "copper_ore", count: 3)],
                    rewards: [Xp(10)],
                    guide: "core:ores",
                ),
                (
                    id: "core:tools/glass",
                    title: "Du verre",
                    text: "Le sable cuit au four devient du verre. Garde-en deux : un bouton de la fiche les remet, et on te donne un petit quelque chose en échange.",
                    x: 5.0, y: 6.75,
                    optional: true,
                    after: ["core:tools/furnace"],
                    tasks: [Item(item: "glass", count: 2, consume: true)],
                    rewards: [Loot("snacks")],
                ),
                (
                    id: "core:tools/ingot",
                    title: "Le premier lingot",
                    subtitle: "Un métal pour de bon",
                    text: "Du cuivre brut en haut du four, du charbon en bas : dix secondes plus tard, un lingot. C'est le premier métal, et la porte des outils qui durent.",
                    x: 7.5, y: 3.4, shape: Hexagon, size: 2.0,
                    after: ["core:tools/furnace", "core:tools/coal", "core:tools/copper"],
                    tasks: [Item(item: "copper_ingot")],
                    rewards: [
                        Choice([(item: "bread", count: 4), (item: "torch", count: 12), (item: "coal", count: 4)]),
                        Xp(15),
                    ],
                    guide: "core:light_and_furnace",
                ),
                (
                    id: "core:tools/copper_pickaxe",
                    title: "Du cuivre au poing",
                    text: "Trois lingots en haut, deux bâtons dessous : une pioche en cuivre, qui dure plus longtemps que celle en pierre.",
                    x: 10.0, y: 3.4, shape: RoundSquare,
                    hidden: true,
                    after: ["core:tools/ingot"],
                    tasks: [Item(item: "copper_pickaxe")],
                    rewards: [Xp(10)],
                ),
            ],
        ),
    ],
)
