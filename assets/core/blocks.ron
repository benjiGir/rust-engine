        liquid: true, light_opacity: 2, texture: "water", fluid: "water", tint: Water,
        hardness: -1.0,
    ),
    (
        id: "core:glass", name: "Verre", color: (0.4964, 0.6959, 0.6027),
        transparent: true, alpha: 0.45, texture: "glass",
        sounds: (step: "step_hard", break: "break_glass", place: "place_hard"),
        hardness: 0.3,
