// Les structures du monde (phase O9) : villages, ruines, donjons, mines abandonnées.
//
// - structures : une par sorte. `kind` : Village, Ruin, Dungeon ou Mine (le dessin est dans
//   crates/engine_voxel/src/generator/structures.rs) ; `spacing` : la taille, en chunks, d'une
//   case de la grille où elle peut apparaître (plus grand = plus rare) ; `chance` : la
//   probabilité qu'une case en contienne une ; `biomes` : où (vide : toutes les terres) ;
//   `loot` : la table de butin de ses coffres.
// - loot : des tables. `rolls` : (min, max) tirages ; chaque tirage choisit une entrée selon
//   son `weight` et en prend `count` (min, max).
//
// Les emplacements ne dépendent que de la graine du monde : le même monde a toujours les
// mêmes structures, chaque chunk dessine sa part sans parler à ses voisins.
(
    structures: [
        (id: "core:village", kind: Village, spacing: 14, chance: 0.6,
         biomes: ["core:plains", "core:forest", "core:birch_forest", "core:taiga", "core:savanna", "core:desert", "core:snowy_tundra", "core:flower_meadow", "core:steppe", "core:shrubland", "core:snowy_taiga", "core:mixed_forest"],
         loot: "village"),
        (id: "core:ruin", kind: Ruin, spacing: 10, chance: 0.4, biomes: [], loot: "ruin"),
        (id: "core:dungeon", kind: Dungeon, spacing: 8, chance: 0.5, biomes: [], loot: "dungeon"),
        (id: "core:mine", kind: Mine, spacing: 9, chance: 0.5, biomes: [], loot: "mine"),
    ],
    loot: {
        "village": (rolls: (2, 4), entries: [
            (item: "core:bread", count: (1, 3), weight: 10),
            (item: "core:carrot", count: (2, 5), weight: 8),
            (item: "core:potato", count: (2, 5), weight: 8),
            (item: "core:seeds", count: (2, 6), weight: 8),
            (item: "core:iron_ingot", count: (1, 2), weight: 4),
            (item: "core:apple", count: (1, 3), weight: 6),
            (item: "core:coal", count: (2, 5), weight: 6),
        ]),
        "ruin": (rolls: (3, 5), entries: [
            (item: "core:iron_ingot", count: (1, 3), weight: 8),
            (item: "core:gold_ingot", count: (1, 2), weight: 5),
            (item: "core:copper_ingot", count: (2, 4), weight: 8),
            (item: "core:stick", count: (2, 6), weight: 8),
            (item: "core:torch", count: (3, 8), weight: 8),
            (item: "core:sapphire", count: (1, 1), weight: 1),
            (item: "core:leather", count: (1, 3), weight: 5),
        ]),
        "dungeon": (rolls: (4, 7), entries: [
            (item: "core:iron_ingot", count: (1, 4), weight: 8),
            (item: "core:gold_ingot", count: (1, 3), weight: 6),
            (item: "core:shadow_dust", count: (1, 3), weight: 6),
            (item: "core:spores", count: (2, 5), weight: 5),
            (item: "core:sapphire", count: (1, 2), weight: 2),
            (item: "core:iron_pickaxe", count: (1, 1), weight: 1),
            (item: "core:iron_sword", count: (1, 1), weight: 1),
            (item: "core:bread", count: (2, 4), weight: 8),
        ]),
        "mine": (rolls: (3, 5), entries: [
            (item: "core:coal", count: (3, 8), weight: 10),
            (item: "core:raw_iron", count: (2, 5), weight: 8),
            (item: "core:raw_copper", count: (2, 6), weight: 8),
            (item: "core:torch", count: (4, 10), weight: 8),
            (item: "core:stone_pickaxe", count: (1, 1), weight: 2),
            (item: "core:malachite", count: (1, 3), weight: 2),
            (item: "core:bread", count: (1, 3), weight: 4),
        ]),
    },
)
