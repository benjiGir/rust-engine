// Le joueur : les couleurs de son bras à la première personne, et les règles de la survie.
//
// Le bras :
// - skin : la peau de la main et de l'avant-bras ;
// - sleeve : la manche, côté épaule ;
// - cuff : le liseré au bout de la manche.
//
// La survie (temps en secondes, dégâts en points de vie, sur 20) :
// - invulnerable : après un coup, les suivants sont ignorés pendant ce temps ;
// - armor_per_point, armor_max : réduction des dégâts par point de protection, et au plus
//   (l'armure n'arrête ni une chute ni la noyade) ;
// - safe_fall : hauteur de chute sans dégâts, puis fall_damage_per_block par bloc de plus ;
// - air : l'air sous l'eau, air_refill : sa reprise par seconde ; sans air, drown_damage
//   toutes les drown_interval secondes ;
// - lava_interval : un coup de lave par intervalle (dégâts du fluide × intervalle) ;
// - burn_time : après la lave, le joueur brûle (l'eau l'éteint), burn_damage toutes
//   les burn_interval secondes.
//
// La faim (sur max_food ; la saturation est une réserve qui s'épuise d'abord) :
// - la fatigue de chaque effort (sprint_per_block, jump, mine, attack, hurt) s'accumule ;
//   chaque exhaustion_per_point retire un point de saturation, puis de faim ;
// - à heal_food ou plus, 1 point de vie revient toutes les heal_interval secondes (au prix
//   de heal_exhaustion de fatigue) ; à 0, starve_damage toutes les starve_interval secondes ;
// - plus de course sous sprint_min_food ; manger prend eat_time secondes, bouton tenu.
//
// Les attributs de base (voir `games/voxel/src/attributes.rs` ; l'équipement et les potions s'y
// ajoutent, tout champ absent garde sa valeur par défaut) :
// - damage : un coup de poing (un outil en main les remplace s'il fait mieux) ;
// - crit_chance : chance de coup critique (0 à 1), crit_damage : son facteur ;
// - life_steal : part des dégâts infligés rendue en vie (0 à 1) ;
// - armor_pierce, armor_pierce_percent : points et part d'armure ignorés par les coups du joueur ;
// - armor : points d'armure sans équipement (chacun retire armor_per_point des dégâts reçus) ;
// - max_health : vie maximale ; regen : points de vie rendus par seconde en plus de la faim ;
// - move_speed, mining_speed : facteurs de vitesse de marche et de minage ;
// - loot_chance : part d'objets de butin en plus (0,25 = un quart) ;
// - reach : portée du bras, en blocs ; xp_gain : facteur du gain d'expérience.
(
    arm: (
        skin: (0.86, 0.66, 0.52),
        sleeve: (0.24, 0.36, 0.33),
        cuff: (0.68, 0.49, 0.31),
    ),
    survival: (
        invulnerable: 0.5,
        armor_per_point: 0.04,
        armor_max: 0.8,
        safe_fall: 3.0,
        fall_damage_per_block: 1.0,
        air: 15.0,
        air_refill: 5.0,
        drown_damage: 2.0,
        drown_interval: 1.0,
        lava_interval: 0.5,
        burn_time: 4.0,
        burn_damage: 1.0,
        burn_interval: 1.0,
    ),
    hunger: (
        max_food: 20.0,
        start_saturation: 5.0,
        exhaustion_per_point: 4.0,
        sprint_per_block: 0.1,
        jump: 0.05,
        mine: 0.005,
        attack: 0.1,
        hurt: 0.1,
        heal_food: 18.0,
        heal_interval: 4.0,
        heal_exhaustion: 6.0,
        starve_damage: 1.0,
        starve_interval: 4.0,
        sprint_min_food: 6.0,
        eat_time: 1.6,
    ),
    attributes: (
        damage: 4.0,
        crit_chance: 0.0,
        crit_damage: 1.5,
        life_steal: 0.0,
        armor_pierce: 0.0,
        armor_pierce_percent: 0.0,
        armor: 0.0,
        max_health: 20.0,
        regen: 0.0,
        move_speed: 1.0,
        mining_speed: 1.0,
        loot_chance: 0.0,
        reach: 6.0,
        xp_gain: 1.0,
    ),
)
