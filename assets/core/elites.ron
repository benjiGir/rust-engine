// Les augmentations des élites (phase « aventure », voir games/voxel/src/elites.rs).
//
// Une élite est une hostile qui a tiré une à trois augmentations ; un envahisseur en a le
// double. Chaque augmentation a un nom qui s'ajoute à celui de la créature (« Zombie colosse »,
// en apposition, donc sans accord), une teinte et un effet :
//   Health(x) : la vie × x ;   Damage(x) : les dégâts × x ;   Speed(x) : la vitesse × x ;
//   Armor(p)  : p points d'armure en plus (voir attributes.rs) ;
//   Regen(h)  : h points de vie rendus par seconde (l'effet d'une potion de régénération).
// - weight : sa part au tirage ; min_tier : le palier à partir duquel elle sort.
(
    // Au plus ce nombre d'augmentations par élite (le premier palier n'en donne qu'une).
    max_picks: 3,
    // Les envahisseurs ont ce multiplicateur de vie en plus, et une teinte à eux.
    invader_health: 1.6,
    invader_color: (1.0, 0.28, 0.9),
    // Le butin garanti. Une élite lâche un objet à affixes d'au moins cette rareté (son numéro),
    // un envahisseur d'une rareté plus haute ; la gemme est tirée avec une chance et un intervalle
    // de qualités (0 à 4) ; la poussière de gemme tombe avec la chance `dust`.
    elite_min_rarity: 1,
    invader_min_rarity: 2,
    elite_gem: (chance: 0.35, quality: (0, 1), dust: 0.5),
    invader_gem: (chance: 1.0, quality: (1, 3), dust: 1.0),
    // Les objets de base des butins à affixes (créatures, élites, envahisseurs), avec le palier
    // minimal du monde à partir duquel ils sortent.
    loot: [
        ("core:wooden_sword", 0), ("core:wooden_pickaxe", 0), ("core:wooden_axe", 0),
        ("core:stone_sword", 0), ("core:stone_pickaxe", 0), ("core:stone_axe", 0), ("core:stone_shovel", 0),
        ("core:copper_sword", 0), ("core:copper_pickaxe", 0), ("core:copper_helmet", 0),
        ("core:copper_chestplate", 0), ("core:copper_leggings", 0), ("core:copper_boots", 0),
        ("core:iron_sword", 1), ("core:iron_axe", 1), ("core:iron_pickaxe", 1), ("core:iron_shovel", 1),
        ("core:iron_helmet", 1), ("core:iron_chestplate", 1), ("core:iron_leggings", 1), ("core:iron_boots", 1),
        ("core:golden_sword", 2), ("core:golden_helmet", 2), ("core:golden_boots", 2),
        ("core:sapphire_sword", 3), ("core:sapphire_axe", 3), ("core:sapphire_pickaxe", 3),
        ("core:sapphire_helmet", 3), ("core:sapphire_chestplate", 3),
        ("core:sapphire_leggings", 4), ("core:sapphire_boots", 4),
    ],
    augmentations: [
        (id: "colossus", title: "colosse", color: (0.9, 0.35, 0.25), effect: Health(1.8), weight: 10, min_tier: 0),
        (id: "butcher", title: "bourreau", color: (0.95, 0.15, 0.15), effect: Damage(1.5), weight: 10, min_tier: 0),
        (id: "lightning", title: "éclair", color: (0.95, 0.9, 0.3), effect: Speed(1.45), weight: 8, min_tier: 0),
        (id: "bastion", title: "bastion", color: (0.5, 0.65, 0.95), effect: Armor(6.0), weight: 7, min_tier: 1),
        (id: "revenant", title: "revenant", color: (0.45, 0.95, 0.55), effect: Regen(1.5), weight: 6, min_tier: 1),
    ],
)
