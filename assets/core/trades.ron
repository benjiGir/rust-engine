// Les échanges des habitants (phase O9). Chaque créature qui commerce (voir entities.ron) a
// une liste d'échanges : `give` ce que le joueur donne (objet, nombre), `get` ce qu'il reçoit,
// `uses` combien de fois l'habitant accepte (il se réapprovisionne en réapparaissant).
//
// La monnaie du pays, c'est le lingot d'or : les habitants rachètent les récoltes et le butin
// des créatures, et vendent des vivres, des outils et des matériaux.
(
    trades: {
        "core:farmer": [
            (give: ("core:wheat", 20), get: ("core:gold_ingot", 1), uses: 8),
            (give: ("core:carrot", 22), get: ("core:gold_ingot", 1), uses: 8),
            (give: ("core:potato", 22), get: ("core:gold_ingot", 1), uses: 8),
            (give: ("core:melon_slice", 12), get: ("core:gold_ingot", 1), uses: 6),
            (give: ("core:gold_ingot", 1), get: ("core:bread", 6), uses: 12),
            (give: ("core:gold_ingot", 1), get: ("core:seeds", 8), uses: 12),
            (give: ("core:gold_ingot", 2), get: ("core:fertilizer", 4), uses: 6),
        ],
        "core:smith": [
            (give: ("core:coal", 15), get: ("core:gold_ingot", 1), uses: 8),
            (give: ("core:raw_iron", 6), get: ("core:gold_ingot", 1), uses: 8),
            (give: ("core:iron_ingot", 4), get: ("core:gold_ingot", 1), uses: 8),
            (give: ("core:gold_ingot", 3), get: ("core:iron_pickaxe", 1), uses: 3),
            (give: ("core:gold_ingot", 3), get: ("core:iron_sword", 1), uses: 3),
            (give: ("core:gold_ingot", 6), get: ("core:iron_chestplate", 1), uses: 2),
            (give: ("core:gold_ingot", 1), get: ("core:iron_ingot", 3), uses: 6),
        ],
        "core:merchant": [
            (give: ("core:leather", 8), get: ("core:gold_ingot", 1), uses: 8),
            (give: ("core:spores", 6), get: ("core:gold_ingot", 1), uses: 8),
            (give: ("core:shadow_dust", 4), get: ("core:gold_ingot", 2), uses: 6),
            (give: ("core:gold_ingot", 1), get: ("core:torch", 12), uses: 12),
            (give: ("core:gold_ingot", 2), get: ("core:shears", 1), uses: 3),
            (give: ("core:gold_ingot", 4), get: ("core:sapphire", 1), uses: 3),
            (give: ("core:gold_ingot", 1), get: ("core:pear", 4), uses: 8),
        ],
    },
)
