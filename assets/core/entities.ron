// Les créatures du jeu, chargées au démarrage comme les blocs.
// Un mod ajoute les siennes dans `mods/<nom>/entities.ron` (voir mods/example).
//
// - size : (largeur, hauteur) de la boîte de collision ;
// - speed : vitesse de marche, en blocs par seconde ; health : points de vie ;
// - hostile : poursuit le joueur et le blesse (damage par coup) ;
// - hops : avance par bonds (comme un slime) ;
// - spawn_on : les blocs sur lesquels elle apparaît ; et, facultatifs (voir
//   games/voxel/src/spawning.rs) : light (min, max), la lumière de la case (par défaut 0 à 7
//   pour une hostile : la nuit et les grottes ; 9 à 15 sinon) ; when (Any, Day, Night) ;
//   biomes (vide : tous) ; group (min, max) ; weight (10) ; dissolves (au soleil ; par
//   défaut, les hostiles) ;
// - breeds : (food, cooldown : 300, growth : 600), l'aliment qui la met en rut, la pause entre deux
//   naissances et le temps de croissance du petit (voir games/voxel/src/breeding.rs) ;
// - drops : son butin à sa mort, (item, count : (min, max), chance : 1.0 par défaut) ;
// - xp : l'expérience qu'elle rapporte (min, max) ;
// - ranged : une attaque à distance, (range, interval, speed, damage, color) : elle s'arrête
//   à portée si elle voit le joueur et lui lance des projectiles ;
// - parts : les boîtes qui la dessinent. offset est le centre de la boîte depuis les
//   pieds, dans le repère de la créature (+x = devant) ; size sa taille ; color sa couleur.
[
    (
        id: "core:pig", name: "Cochon", health: 10.0, speed: 1.6, size: (0.9, 0.9),
        spawn_on: ["core:grass"], group: (2, 3),
        breeds: (food: "core:carrot"),
        drops: [(item: "core:raw_pork", count: (1, 3))],
        xp: (1, 3),
        parts: [
