// Les paliers du monde (phase « aventure », voir games/voxel/src/tiers.rs).
//
// Un palier renforce les créatures hostiles et relève les chances de rareté. On choisit celui
// qu'on veut parmi ceux qu'on a débloqués (touche « Paliers du monde » des options, par défaut J).
// Leur ORDRE compte : le palier choisi est sauvegardé par son numéro dans world.ron.
//
// - id, name, description ;
// - health, damage : les multiplicateurs de vie et de dégâts des créatures hostiles ;
// - rarity_boost : à chaque cran de rareté, le poids est multiplié par (1 + rarity_boost) ^ cran ;
// - elite_chance : la part des hostiles qui naissent élites ;
// - drop_chance : la chance qu'une hostile lâche un objet à affixes ;
// - invader : le temps (en secondes) entre deux envahisseurs, (min, max) ; (0, 0) : aucun ;
// - unlock : TOUS les critères doivent être remplis (mais un palier débloqué le reste) :
//     Kills(n)  : n hostiles tuées ;      Bosses(n) : n boss vaincus (`boss: true` dans entities.ron) ;
//     Rarity(r) : un objet de rareté r (numéro) obtenu ;      Depth(n) : n blocs sous le niveau de la mer.
[
    (id: "haven", name: "Havre", description: "Le monde tel qu'il est. Rien ne change.",
     health: 1.0, damage: 1.0, rarity_boost: 0.0, elite_chance: 0.03, drop_chance: 0.04,
     invader: (0, 0), unlock: []),
    (id: "frontier", name: "Frontière", description: "Les créatures se font plus rudes, le butin plus riche.",
     health: 1.3, damage: 1.2, rarity_boost: 0.35, elite_chance: 0.07, drop_chance: 0.07,
     invader: (0, 0), unlock: [Kills(25)]),
    (id: "ascent", name: "Ascension", description: "Des envahisseurs surgissent, annoncés par un faisceau de lumière.",
     health: 1.7, damage: 1.5, rarity_boost: 0.8, elite_chance: 0.12, drop_chance: 0.1,
     invader: (240, 420), unlock: [Kills(100), Depth(20)]),
    (id: "summit", name: "Sommet", description: "Les élites sont nombreuses ; les envahisseurs reviennent plus vite.",
     health: 2.2, damage: 1.9, rarity_boost: 1.4, elite_chance: 0.18, drop_chance: 0.14,
     invader: (150, 280), unlock: [Kills(250), Bosses(1)]),
    (id: "pinnacle", name: "Apogée", description: "Le plus haut défi : de beaux objets, mais des créatures redoutables.",
     health: 3.0, damage: 2.4, rarity_boost: 2.2, elite_chance: 0.28, drop_chance: 0.2,
     invader: (90, 180), unlock: [Kills(500), Bosses(1), Rarity(3), Depth(40)]),
]
