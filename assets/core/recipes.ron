// Les recettes d'artisanat.
//
// - shaped : une forme dans la grille (2 × 2 dans l'inventaire, 3 × 3 sur l'établi). La
//   forme peut être placée n'importe où dans la grille, et retournée gauche-droite. `key`
//   dit ce que désigne chaque lettre : un objet (`stick`) ou un groupe (`#planks`) ;
//   un espace est une case vide.
// - shapeless : les ingrédients, dans n'importe quel ordre et n'importe où.
// - result : (objet, quantité).
(
    shaped: [
        (pattern: ["#", "#"], key: {"#": "#planks"}, result: ("stick", 4)),
        (pattern: ["##", "##"], key: {"#": "#planks"}, result: ("workbench", 1)),
        (pattern: ["###", "# #", "###"], key: {"#": "#stones"}, result: ("furnace", 1)),
        // Les circuits (phase O8).
        (pattern: ["s", "#"], key: {"s": "stick", "#": "cobblestone"}, result: ("lever", 1)),
        (pattern: ["c", "s"], key: {"c": "cinnabar_dust", "s": "stick"}, result: ("inverter", 1)),
        (pattern: ["cic", "sss"], key: {"c": "cinnabar_dust", "i": "inverter", "s": "stone"}, result: ("repeater", 1)),
        (pattern: ["ii", "ii", "ii"], key: {"i": "iron_ingot"}, result: ("gate", 1)),
        (pattern: ["PPP", "#i#", "#c#"], key: {"P": "#planks", "#": "cobblestone", "i": "iron_ingot", "c": "cinnabar_dust"}, result: ("piston", 1)),
        (pattern: ["www"], key: {"w": "wheat"}, result: ("bread", 1)),
        (pattern: ["###", "# #", "###"], key: {"#": "#planks"}, result: ("chest", 1)),
        (pattern: ["LLL", "PPP"], key: {"L": "#leaves", "P": "#planks"}, result: ("bed", 1)),
        (pattern: ["c", "s"], key: {"c": "#coals", "s": "stick"}, result: ("torch", 4)),
        (pattern: ["##", "##"], key: {"#": "sand"}, result: ("sandstone", 1)),
        (pattern: ["###", "#c#", "###"], key: {"#": "cobblestone", "c": "cinnabar_dust"}, result: ("clock", 1)),
        (pattern: [" c ", "cgc", " c "], key: {"c": "cinnabar_dust", "g": "glowstone"}, result: ("lamp", 1)),
        (pattern: [" i", "i "], key: {"i": "iron_ingot"}, result: ("shears", 1)),
        (pattern: ["i i", " i "], key: {"i": "iron_ingot"}, result: ("bucket", 1)),
        (pattern: ["MMM", " S ", " S "], key: {"M": "#planks", "S": "stick"}, result: ("wooden_pickaxe", 1)),
        (pattern: ["MM", "MS", " S"], key: {"M": "#planks", "S": "stick"}, result: ("wooden_axe", 1)),
        (pattern: ["M", "S", "S"], key: {"M": "#planks", "S": "stick"}, result: ("wooden_shovel", 1)),
        (pattern: ["MM", " S", " S"], key: {"M": "#planks", "S": "stick"}, result: ("wooden_hoe", 1)),
        (pattern: ["M", "M", "S"], key: {"M": "#planks", "S": "stick"}, result: ("wooden_sword", 1)),
        (pattern: ["MMM", " S ", " S "], key: {"M": "#stones", "S": "stick"}, result: ("stone_pickaxe", 1)),
        (pattern: ["MM", "MS", " S"], key: {"M": "#stones", "S": "stick"}, result: ("stone_axe", 1)),
        (pattern: ["M", "S", "S"], key: {"M": "#stones", "S": "stick"}, result: ("stone_shovel", 1)),
        (pattern: ["MM", " S", " S"], key: {"M": "#stones", "S": "stick"}, result: ("stone_hoe", 1)),
        (pattern: ["M", "M", "S"], key: {"M": "#stones", "S": "stick"}, result: ("stone_sword", 1)),
        (pattern: ["MMM", " S ", " S "], key: {"M": "copper_ingot", "S": "stick"}, result: ("copper_pickaxe", 1)),
        (pattern: ["MM", "MS", " S"], key: {"M": "copper_ingot", "S": "stick"}, result: ("copper_axe", 1)),
        (pattern: ["M", "S", "S"], key: {"M": "copper_ingot", "S": "stick"}, result: ("copper_shovel", 1)),
        (pattern: ["MM", " S", " S"], key: {"M": "copper_ingot", "S": "stick"}, result: ("copper_hoe", 1)),
        (pattern: ["M", "M", "S"], key: {"M": "copper_ingot", "S": "stick"}, result: ("copper_sword", 1)),
        (pattern: ["MMM", " S ", " S "], key: {"M": "iron_ingot", "S": "stick"}, result: ("iron_pickaxe", 1)),
        (pattern: ["MM", "MS", " S"], key: {"M": "iron_ingot", "S": "stick"}, result: ("iron_axe", 1)),
        (pattern: ["M", "S", "S"], key: {"M": "iron_ingot", "S": "stick"}, result: ("iron_shovel", 1)),
        (pattern: ["MM", " S", " S"], key: {"M": "iron_ingot", "S": "stick"}, result: ("iron_hoe", 1)),
        (pattern: ["M", "M", "S"], key: {"M": "iron_ingot", "S": "stick"}, result: ("iron_sword", 1)),
        (pattern: ["MMM", " S ", " S "], key: {"M": "gold_ingot", "S": "stick"}, result: ("golden_pickaxe", 1)),
        (pattern: ["MM", "MS", " S"], key: {"M": "gold_ingot", "S": "stick"}, result: ("golden_axe", 1)),
        (pattern: ["M", "S", "S"], key: {"M": "gold_ingot", "S": "stick"}, result: ("golden_shovel", 1)),
        (pattern: ["MM", " S", " S"], key: {"M": "gold_ingot", "S": "stick"}, result: ("golden_hoe", 1)),
        (pattern: ["M", "M", "S"], key: {"M": "gold_ingot", "S": "stick"}, result: ("golden_sword", 1)),
        (pattern: ["MMM", " S ", " S "], key: {"M": "sapphire", "S": "stick"}, result: ("sapphire_pickaxe", 1)),
        (pattern: ["MM", "MS", " S"], key: {"M": "sapphire", "S": "stick"}, result: ("sapphire_axe", 1)),
        (pattern: ["M", "S", "S"], key: {"M": "sapphire", "S": "stick"}, result: ("sapphire_shovel", 1)),
        (pattern: ["MM", " S", " S"], key: {"M": "sapphire", "S": "stick"}, result: ("sapphire_hoe", 1)),
        (pattern: ["M", "M", "S"], key: {"M": "sapphire", "S": "stick"}, result: ("sapphire_sword", 1)),
        (pattern: ["MMM", "M M"], key: {"M": "copper_ingot"}, result: ("copper_helmet", 1)),
        (pattern: ["M M", "MMM", "MMM"], key: {"M": "copper_ingot"}, result: ("copper_chestplate", 1)),
        (pattern: ["MMM", "M M", "M M"], key: {"M": "copper_ingot"}, result: ("copper_leggings", 1)),
        (pattern: ["M M", "M M"], key: {"M": "copper_ingot"}, result: ("copper_boots", 1)),
        (pattern: ["MMM", "M M"], key: {"M": "iron_ingot"}, result: ("iron_helmet", 1)),
        (pattern: ["M M", "MMM", "MMM"], key: {"M": "iron_ingot"}, result: ("iron_chestplate", 1)),
        (pattern: ["MMM", "M M", "M M"], key: {"M": "iron_ingot"}, result: ("iron_leggings", 1)),
        (pattern: ["M M", "M M"], key: {"M": "iron_ingot"}, result: ("iron_boots", 1)),
        (pattern: ["MMM", "M M"], key: {"M": "gold_ingot"}, result: ("golden_helmet", 1)),
        (pattern: ["M M", "MMM", "MMM"], key: {"M": "gold_ingot"}, result: ("golden_chestplate", 1)),
        (pattern: ["MMM", "M M", "M M"], key: {"M": "gold_ingot"}, result: ("golden_leggings", 1)),
        (pattern: ["M M", "M M"], key: {"M": "gold_ingot"}, result: ("golden_boots", 1)),
        (pattern: ["MMM", "M M"], key: {"M": "sapphire"}, result: ("sapphire_helmet", 1)),
        (pattern: ["M M", "MMM", "MMM"], key: {"M": "sapphire"}, result: ("sapphire_chestplate", 1)),
        (pattern: ["MMM", "M M", "M M"], key: {"M": "sapphire"}, result: ("sapphire_leggings", 1)),
        (pattern: ["M M", "M M"], key: {"M": "sapphire"}, result: ("sapphire_boots", 1)),
    ],
    shapeless: [
        (ingredients: ["oak_log"], result: ("oak_planks", 4)),
        (ingredients: ["birch_log"], result: ("birch_planks", 4)),
        (ingredients: ["spruce_log"], result: ("spruce_planks", 4)),
        (ingredients: ["acacia_log"], result: ("acacia_planks", 4)),
        (ingredients: ["jungle_log"], result: ("jungle_planks", 4)),
        (ingredients: ["spores", "seeds", "dirt"], result: ("fertilizer", 2)),
        (ingredients: ["melon_slice"], result: ("melon_seeds", 1)),
        (ingredients: ["cinnabar_dust"], result: ("wire", 3)),
        (ingredients: ["stone"], result: ("button", 2)),
        (ingredients: ["spores", "piston"], result: ("sticky_piston", 1)),
        (ingredients: ["flint", "iron_ingot"], result: ("torch", 8)),
    ],
)
