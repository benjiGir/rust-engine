// Les recettes d'artisanat.
//
// - shaped : une forme dans la grille (2 × 2 dans l'inventaire, 3 × 3 sur l'établi). La
//   forme peut être placée n'importe où dans la grille, et retournée gauche-droite. `key`
//   dit ce que désigne chaque lettre : un objet (`stick`) ou un groupe (`#planks`) ;
//   un espace est une case vide.
// - shapeless : les ingrédients, dans n'importe quel ordre et n'importe où.
// - result : (objet, quantité).
(
    shaped: [
        (pattern: ["#", "#"], key: {"#": "#planks"}, result: ("stick", 4)),
        (pattern: ["##", "##"], key: {"#": "#planks"}, result: ("workbench", 1)),
        (pattern: ["###", "# #", "###"], key: {"#": "#stones"}, result: ("furnace", 1)),
        // Les circuits (phase O8).
        (pattern: ["s", "#"], key: {"s": "stick", "#": "cobblestone"}, result: ("lever", 1)),
        (pattern: ["c", "s"], key: {"c": "cinnabar_dust", "s": "stick"}, result: ("inverter", 1)),
        (pattern: ["cic", "sss"], key: {"c": "cinnabar_dust", "i": "inverter", "s": "stone"}, result: ("repeater", 1)),
        (pattern: ["ii", "ii", "ii"], key: {"i": "iron_ingot"}, result: ("gate", 1)),
        (pattern: ["PPP", "#i#", "#c#"], key: {"P": "#planks", "#": "cobblestone", "i": "iron_ingot", "c": "cinnabar_dust"}, result: ("piston", 1)),
        (pattern: [" s ", "#s#", "###"], key: {"s": "sapphire", "#": "cobblestone"}, result: ("enchanting_table", 1)),
        // L'aventure : les tables du butin et les sceaux des gemmes.
        (pattern: ["ii", "pp"], key: {"i": "iron_ingot", "p": "#planks"}, result: ("salvage_table", 1)),
        (pattern: ["gsg", "###"], key: {"g": "gold_ingot", "s": "sapphire", "#": "cobblestone"}, result: ("reforge_table", 1)),
        (pattern: ["d", "i"], key: {"d": "gem_dust", "i": "iron_ingot"}, result: ("seal_unsocket", 1)),
        (pattern: ["dg"], key: {"d": "gem_dust", "g": "gold_ingot"}, result: ("seal_socket", 1)),
        // L'enchantement avancé : livres et tomes, étagères, bibliothèque, enclume, charmes de potion.
        (pattern: ["ll", "ls"], key: {"l": "leather", "s": "stick"}, result: ("book", 1)),
        (pattern: ["ibi"], key: {"i": "iron_ingot", "b": "book"}, result: ("tome_weapons", 1)),
        (pattern: ["cbc"], key: {"c": "copper_ingot", "b": "book"}, result: ("tome_tools", 1)),
        (pattern: ["gbg"], key: {"g": "gold_ingot", "b": "book"}, result: ("tome_armor", 1)),
        (pattern: ["dbd", " s "], key: {"d": "gem_dust", "b": "book", "s": "sapphire"}, result: ("tome_extraction", 1)),
        (pattern: ["ppp", "bbb", "ppp"], key: {"p": "#planks", "b": "book"}, result: ("shelf_oak", 1)),
        (pattern: ["sss", "bbb", "sss"], key: {"s": "sapphire", "b": "book"}, result: ("shelf_sapphire", 1)),
        (pattern: ["aaa", "bbb", "aaa"], key: {"a": "gem_amethyst_3", "b": "book"}, result: ("shelf_amethyst", 1)),
        (pattern: ["jjj", "bbb", "jjj"], key: {"j": "jade", "b": "book"}, result: ("shelf_jade", 1)),
        (pattern: ["vvv", "bgb", "vvv"], key: {"v": "volcanic_rock", "b": "book", "g": "gold_ingot"}, result: ("shelf_volcanic", 1)),
        (pattern: ["bsb", "bpb", "bsb"], key: {"b": "book", "s": "sapphire", "p": "#planks"}, result: ("enchant_library", 1)),
        (pattern: ["iii", " i ", "iii"], key: {"i": "iron_ingot"}, result: ("simple_anvil", 1)),
        (pattern: [" i ", "ipi", " i "], key: {"i": "iron_ingot", "p": "potion_healing"}, result: ("charm_healing", 1)),
        (pattern: [" i ", "ipi", " i "], key: {"i": "iron_ingot", "p": "potion_regeneration"}, result: ("charm_regeneration", 1)),
        (pattern: [" i ", "ipi", " i "], key: {"i": "iron_ingot", "p": "potion_speed"}, result: ("charm_speed", 1)),
        (pattern: [" i ", "ipi", " i "], key: {"i": "iron_ingot", "p": "potion_strength"}, result: ("charm_strength", 1)),
        (pattern: [" i ", "ipi", " i "], key: {"i": "iron_ingot", "p": "potion_fire_resistance"}, result: ("charm_fire_resistance", 1)),
        (pattern: ["g g", " g "], key: {"g": "glass"}, result: ("flask", 3)),
        (pattern: [" i ", "###"], key: {"i": "iron_ingot", "#": "cobblestone"}, result: ("brewing_stand", 1)),
        // Les réseaux (phase 9c).
        (pattern: ["ccc"], key: {"c": "copper_ingot"}, result: ("cable", 6)),
        (pattern: ["iii"], key: {"i": "iron_ingot"}, result: ("pipe", 6)),
        (pattern: ["p", "p"], key: {"p": "#planks"}, result: ("shaft", 4)),
        (pattern: ["ggg", "ccc", "###"], key: {"g": "glass", "c": "copper_ingot", "#": "cobblestone"}, result: ("solar_panel", 1)),
        (pattern: ["c", "d", "c"], key: {"c": "copper_ingot", "d": "cinnabar_dust"}, result: ("battery", 1)),
        (pattern: ["iii", "igi", "iii"], key: {"i": "iron_ingot", "g": "glass"}, result: ("tank", 1)),
        (pattern: ["ccc", "cic", "ccc"], key: {"c": "copper_ingot", "i": "iron_ingot"}, result: ("motor", 1)),
        (pattern: ["i i", " c ", "i i"], key: {"i": "iron_ingot", "c": "copper_ingot"}, result: ("fan", 1)),
        // Les structures mobiles (phase 9d).
        (pattern: ["iii", "isi", "iii"], key: {"i": "iron_ingot", "s": "sapphire"}, result: ("assembler", 1)),
        (pattern: ["ll", "ll"], key: {"l": "leather"}, result: ("balloon", 1)),
        (pattern: ["ppp", "psp", "ppp"], key: {"p": "#planks", "s": "stick"}, result: ("helm", 1)),
        // Les rails et les wagons.
        (pattern: ["i i", "isi", "i i"], key: {"i": "iron_ingot", "s": "stick"}, result: ("rail", 16)),
        (pattern: ["g g", "gsg", "gcg"], key: {"g": "gold_ingot", "s": "stick", "c": "cinnabar_dust"}, result: ("booster_rail", 6)),
        (pattern: ["i i", "i#i", "ici"], key: {"i": "iron_ingot", "#": "stone", "c": "cinnabar_dust"}, result: ("detector_rail", 6)),
        (pattern: ["isi", "ici", "isi"], key: {"i": "iron_ingot", "s": "stick", "c": "cinnabar_dust"}, result: ("activator_rail", 6)),
        (pattern: ["iii", "# #"], key: {"i": "iron_ingot", "#": "cobblestone"}, result: ("buffer_stop", 2)),
        (pattern: ["i i", "iii"], key: {"i": "iron_ingot"}, result: ("minecart", 1)),
        (pattern: ["is", "si"], key: {"i": "iron_ingot", "s": "stick"}, result: ("coupler", 2)),
        (pattern: ["#i#", "#c#", "###"], key: {"#": "cobblestone", "i": "iron_ingot", "c": "chest"}, result: ("cart_loader", 1)),
        (pattern: ["###", "#c#", "#i#"], key: {"#": "cobblestone", "i": "iron_ingot", "c": "chest"}, result: ("cart_unloader", 1)),
        (pattern: ["www"], key: {"w": "wheat"}, result: ("bread", 1)),
        (pattern: ["###", "# #", "###"], key: {"#": "#planks"}, result: ("chest", 1)),
        (pattern: ["LLL", "PPP"], key: {"L": "#leaves", "P": "#planks"}, result: ("bed", 1)),
        (pattern: ["LLL", "PPP"], key: {"L": "#wools", "P": "#planks"}, result: ("bed", 1)),
        (pattern: ["c", "s"], key: {"c": "#coals", "s": "stick"}, result: ("torch", 4)),
        (pattern: ["##", "##"], key: {"#": "sand"}, result: ("sandstone", 1)),
        (pattern: ["###", "#c#", "###"], key: {"#": "cobblestone", "c": "cinnabar_dust"}, result: ("clock", 1)),
        (pattern: [" c ", "cgc", " c "], key: {"c": "cinnabar_dust", "g": "glowstone"}, result: ("lamp", 1)),
        (pattern: [" i", "i "], key: {"i": "iron_ingot"}, result: ("shears", 1)),
        (pattern: ["i i", " i "], key: {"i": "iron_ingot"}, result: ("bucket", 1)),
        (pattern: ["MMM", " S ", " S "], key: {"M": "#planks", "S": "stick"}, result: ("wooden_pickaxe", 1)),
        (pattern: ["MM", "MS", " S"], key: {"M": "#planks", "S": "stick"}, result: ("wooden_axe", 1)),
        (pattern: ["M", "S", "S"], key: {"M": "#planks", "S": "stick"}, result: ("wooden_shovel", 1)),
        (pattern: ["MM", " S", " S"], key: {"M": "#planks", "S": "stick"}, result: ("wooden_hoe", 1)),
        (pattern: ["M", "M", "S"], key: {"M": "#planks", "S": "stick"}, result: ("wooden_sword", 1)),
        (pattern: ["MMM", " S ", " S "], key: {"M": "#stones", "S": "stick"}, result: ("stone_pickaxe", 1)),
        (pattern: ["MM", "MS", " S"], key: {"M": "#stones", "S": "stick"}, result: ("stone_axe", 1)),
        (pattern: ["M", "S", "S"], key: {"M": "#stones", "S": "stick"}, result: ("stone_shovel", 1)),
        (pattern: ["MM", " S", " S"], key: {"M": "#stones", "S": "stick"}, result: ("stone_hoe", 1)),
        (pattern: ["M", "M", "S"], key: {"M": "#stones", "S": "stick"}, result: ("stone_sword", 1)),
        (pattern: ["MMM", " S ", " S "], key: {"M": "copper_ingot", "S": "stick"}, result: ("copper_pickaxe", 1)),
        (pattern: ["MM", "MS", " S"], key: {"M": "copper_ingot", "S": "stick"}, result: ("copper_axe", 1)),
        (pattern: ["M", "S", "S"], key: {"M": "copper_ingot", "S": "stick"}, result: ("copper_shovel", 1)),
        (pattern: ["MM", " S", " S"], key: {"M": "copper_ingot", "S": "stick"}, result: ("copper_hoe", 1)),
        (pattern: ["M", "M", "S"], key: {"M": "copper_ingot", "S": "stick"}, result: ("copper_sword", 1)),
        (pattern: ["MMM", " S ", " S "], key: {"M": "iron_ingot", "S": "stick"}, result: ("iron_pickaxe", 1)),
        (pattern: ["MM", "MS", " S"], key: {"M": "iron_ingot", "S": "stick"}, result: ("iron_axe", 1)),
        (pattern: ["M", "S", "S"], key: {"M": "iron_ingot", "S": "stick"}, result: ("iron_shovel", 1)),
        (pattern: ["MM", " S", " S"], key: {"M": "iron_ingot", "S": "stick"}, result: ("iron_hoe", 1)),
        (pattern: ["M", "M", "S"], key: {"M": "iron_ingot", "S": "stick"}, result: ("iron_sword", 1)),
        (pattern: ["MMM", " S ", " S "], key: {"M": "gold_ingot", "S": "stick"}, result: ("golden_pickaxe", 1)),
        (pattern: ["MM", "MS", " S"], key: {"M": "gold_ingot", "S": "stick"}, result: ("golden_axe", 1)),
        (pattern: ["M", "S", "S"], key: {"M": "gold_ingot", "S": "stick"}, result: ("golden_shovel", 1)),
        (pattern: ["MM", " S", " S"], key: {"M": "gold_ingot", "S": "stick"}, result: ("golden_hoe", 1)),
        (pattern: ["M", "M", "S"], key: {"M": "gold_ingot", "S": "stick"}, result: ("golden_sword", 1)),
        (pattern: ["MMM", " S ", " S "], key: {"M": "sapphire", "S": "stick"}, result: ("sapphire_pickaxe", 1)),
        (pattern: ["MM", "MS", " S"], key: {"M": "sapphire", "S": "stick"}, result: ("sapphire_axe", 1)),
        (pattern: ["M", "S", "S"], key: {"M": "sapphire", "S": "stick"}, result: ("sapphire_shovel", 1)),
        (pattern: ["MM", " S", " S"], key: {"M": "sapphire", "S": "stick"}, result: ("sapphire_hoe", 1)),
        (pattern: ["M", "M", "S"], key: {"M": "sapphire", "S": "stick"}, result: ("sapphire_sword", 1)),
        (pattern: ["MMM", "M M"], key: {"M": "copper_ingot"}, result: ("copper_helmet", 1)),
        (pattern: ["M M", "MMM", "MMM"], key: {"M": "copper_ingot"}, result: ("copper_chestplate", 1)),
        (pattern: ["MMM", "M M", "M M"], key: {"M": "copper_ingot"}, result: ("copper_leggings", 1)),
        (pattern: ["M M", "M M"], key: {"M": "copper_ingot"}, result: ("copper_boots", 1)),
        (pattern: ["MMM", "M M"], key: {"M": "iron_ingot"}, result: ("iron_helmet", 1)),
        (pattern: ["M M", "MMM", "MMM"], key: {"M": "iron_ingot"}, result: ("iron_chestplate", 1)),
        (pattern: ["MMM", "M M", "M M"], key: {"M": "iron_ingot"}, result: ("iron_leggings", 1)),
        (pattern: ["M M", "M M"], key: {"M": "iron_ingot"}, result: ("iron_boots", 1)),
        (pattern: ["MMM", "M M"], key: {"M": "gold_ingot"}, result: ("golden_helmet", 1)),
        (pattern: ["M M", "MMM", "MMM"], key: {"M": "gold_ingot"}, result: ("golden_chestplate", 1)),
        (pattern: ["MMM", "M M", "M M"], key: {"M": "gold_ingot"}, result: ("golden_leggings", 1)),
        (pattern: ["M M", "M M"], key: {"M": "gold_ingot"}, result: ("golden_boots", 1)),
        (pattern: ["MMM", "M M"], key: {"M": "sapphire"}, result: ("sapphire_helmet", 1)),
        (pattern: ["M M", "MMM", "MMM"], key: {"M": "sapphire"}, result: ("sapphire_chestplate", 1)),
        (pattern: ["MMM", "M M", "M M"], key: {"M": "sapphire"}, result: ("sapphire_leggings", 1)),
        (pattern: ["M M", "M M"], key: {"M": "sapphire"}, result: ("sapphire_boots", 1)),
        // Le stockage (voir docs/plan-stockage.md). Un bloc de métal se fabrique avec neuf lingots,
        // et le compactage d'un coffre ne s'applique qu'à ce qu'une recette sait défaire.
        (pattern: ["iii", "iii", "iii"], key: {"i": "iron_ingot"}, result: ("iron_block", 1)),
        (pattern: ["ccc", "ccc", "ccc"], key: {"c": "copper_ingot"}, result: ("copper_block", 1)),
        (pattern: ["ggg", "ggg", "ggg"], key: {"g": "gold_ingot"}, result: ("gold_block", 1)),
        (pattern: ["sss", "sss", "sss"], key: {"s": "sapphire"}, result: ("sapphire_block", 1)),
        (pattern: ["ccc", "ccc", "ccc"], key: {"c": "coal"}, result: ("coal_block", 1)),
        // Les kits de palier : un clic droit sur un coffre du palier juste en dessous.
        (pattern: ["ccc", "c#c", "ccc"], key: {"c": "copper_ingot", "#": "#planks"}, result: ("copper_kit", 1)),
        (pattern: ["iii", "ici", "iii"], key: {"i": "iron_ingot", "c": "copper_ingot"}, result: ("iron_kit", 1)),
        (pattern: ["ggg", "gig", "ggg"], key: {"g": "gold_ingot", "i": "iron_ingot"}, result: ("gold_kit", 1)),
        (pattern: ["sss", "sgs", "sss"], key: {"s": "sapphire", "g": "gold_ingot"}, result: ("sapphire_kit", 1)),
        // Les améliorations : un anneau de métal autour de ce qui donne la fonction.
        (pattern: ["iii", "i#i", "iii"], key: {"i": "iron_ingot", "#": "#planks"}, result: ("upgrade_stack_2", 1)),
        (pattern: ["ggg", "gug", "ggg"], key: {"g": "gold_ingot", "u": "upgrade_stack_2"}, result: ("upgrade_stack_4", 1)),
        (pattern: ["iii", "ipi", "iii"], key: {"i": "iron_ingot", "p": "piston"}, result: ("upgrade_compact", 1)),
        (pattern: ["ddd", "dsd", "ddd"], key: {"d": "shadow_dust", "s": "sapphire"}, result: ("upgrade_void", 1)),
        (pattern: ["iii", "ipi", "iii"], key: {"i": "iron_ingot", "p": "pipe"}, result: ("upgrade_funnel", 1)),
        (pattern: ["ccc", "cbc", "ccc"], key: {"c": "copper_ingot", "b": "bucket"}, result: ("upgrade_pickup", 1)),
        (pattern: ["c c", "i i", "iii"], key: {"c": "cinnabar_dust", "i": "iron_ingot"}, result: ("upgrade_magnet", 1)),
        (pattern: ["ccc", "chc", "ccc"], key: {"c": "copper_ingot", "h": "chest"}, result: ("upgrade_restock", 1)),
        (pattern: ["ggg", "gbg", "ggg"], key: {"g": "gold_ingot", "b": "bread"}, result: ("upgrade_feed", 1)),
        (pattern: ["l l", "lcl", "lll"], key: {"l": "leather", "c": "chest"}, result: ("backpack_leather", 1)),
        (pattern: ["#i#", "# #", "###"], key: {"#": "iron_ingot", "i": "sapphire"}, result: ("storage_controller", 1)),
    ],
    shapeless: [
        // Le Guide du voyageur : une planche et un bâton, dès les premières minutes.
        (ingredients: ["#planks", "stick"], result: ("guide", 1)),
        (ingredients: ["oak_log"], result: ("oak_planks", 4)),
        (ingredients: ["birch_log"], result: ("birch_planks", 4)),
        (ingredients: ["spruce_log"], result: ("spruce_planks", 4)),
        (ingredients: ["acacia_log"], result: ("acacia_planks", 4)),
        (ingredients: ["jungle_log"], result: ("jungle_planks", 4)),
        (ingredients: ["spores", "seeds", "dirt"], result: ("fertilizer", 2)),
        (ingredients: ["melon_slice"], result: ("melon_seeds", 1)),
        (ingredients: ["cinnabar_dust"], result: ("wire", 3)),
        (ingredients: ["stone"], result: ("button", 2)),
        (ingredients: ["spores", "piston"], result: ("sticky_piston", 1)),
        (ingredients: ["lamp", "copper_ingot"], result: ("power_lamp", 1)),
        (ingredients: ["pipe", "bucket", "iron_ingot"], result: ("pump", 1)),
        (ingredients: ["pipe", "bucket"], result: ("filler", 1)),
        (ingredients: ["fan", "iron_ingot"], result: ("propeller", 1)),
        (ingredients: ["flint", "iron_ingot"], result: ("torch", 8)),
        (ingredients: ["minecart", "chest"], result: ("chest_cart", 1)),
        (ingredients: ["minecart", "chest", "iron_ingot"], result: ("hopper_cart", 1)),
        (ingredients: ["minecart", "furnace"], result: ("locomotive", 1)),
        // Le stockage : un bloc de métal se défait en neuf lingots ; les kits directs réunissent les
        // kits des paliers qu'ils sautent ; un sac monte de palier avec le kit du palier visé.
        (ingredients: ["iron_block"], result: ("iron_ingot", 9)),
        (ingredients: ["copper_block"], result: ("copper_ingot", 9)),
        (ingredients: ["gold_block"], result: ("gold_ingot", 9)),
        (ingredients: ["sapphire_block"], result: ("sapphire", 9)),
        (ingredients: ["coal_block"], result: ("coal", 9)),
        (ingredients: ["copper_kit", "iron_kit"], result: ("iron_direct_kit", 1)),
        (ingredients: ["copper_kit", "iron_kit", "gold_kit"], result: ("gold_direct_kit", 1)),
        (ingredients: ["copper_kit", "iron_kit", "gold_kit", "sapphire_kit"], result: ("sapphire_direct_kit", 1)),
        (ingredients: ["backpack_leather", "copper_kit"], result: ("backpack_copper", 1)),
        (ingredients: ["backpack_copper", "iron_kit"], result: ("backpack_iron", 1)),
        (ingredients: ["backpack_iron", "sapphire_kit"], result: ("backpack_sapphire", 1)),
    ],
)
