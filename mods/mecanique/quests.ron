// Le chapitre de la mécanique dans le livre de quêtes (voir assets/core/quests.ron et docs/modding.md).
(
    chapters: [(
        id: "mecanique:rotation",
        group: "core:mods",
        title: "Mécanique",
        icon: "gear",
        quests: [
            (
                id: "mecanique:rotation/crank",
                title: "Une manivelle",
                subtitle: "Faire tourner à la main",
                text: "Un bâton au-dessus d'un moellon. Un clic droit la fait tourner quelques secondes : c'est la source de rotation la plus simple.",
                x: 0.0, y: 3.75, shape: Square,
                after: ["core:networks/shaft"],
                tasks: [Item(item: "crank")],
                rewards: [Xp(10)],
            ),
            (
                id: "mecanique:rotation/shaft",
                title: "Des arbres de transmission",
                text: "Trois bâtons en colonne donnent trois arbres. Ils portent la rotation d'une machine à l'autre.",
                x: 3.0, y: 1.25,
                after: ["mecanique:rotation/crank"],
                tasks: [Item(item: "shaft", count: 3)],
                rewards: [Xp(10)],
            ),
            (
                id: "mecanique:rotation/gear",
                title: "Un engrenage",
                text: "Un lingot de fer au centre, quatre planches en croix autour. Il se glisse dans une ligne d'arbres.",
                x: 3.0, y: 6.25, shape: Diamond,
                after: ["mecanique:rotation/crank"],
                tasks: [Item(item: "gear")],
                rewards: [Xp(10)],
            ),
            (
                id: "mecanique:rotation/press",
                title: "Une presse",
                subtitle: "Du métal en plaques",
                text: "Huit moellons autour d'un engrenage. Reliée à une manivelle par des arbres, elle presse l'objet de sa case d'entrée : un lingot de fer ou de cuivre devient une plaque.",
                x: 6.5, y: 3.75, shape: Hexagon, size: 2.0,
                after: ["mecanique:rotation/shaft", "mecanique:rotation/gear"],
                tasks: [Item(item: "press")],
                rewards: [Item(item: "core:coal", count: 6), Xp(25)],
            ),
            (
                id: "mecanique:rotation/plate",
                title: "Des plaques de fer",
                text: "Mets un lingot de fer dans la case d'entrée de la presse, et fais tourner la manivelle : deux secondes à pleine vitesse par plaque.",
                x: 10.0, y: 1.25, shape: RoundSquare,
                after: ["mecanique:rotation/press"],
                tasks: [Item(item: "iron_plate", count: 4)],
                rewards: [Xp(15)],
            ),
            (
                id: "mecanique:rotation/belt",
                title: "Des courroies",
                text: "Trois cuirs au-dessus de trois plaques de fer : six courroies. Elles portent les objets entre les machines et les coffres qu'elles touchent.",
                x: 13.0, y: 1.25,
                after: ["mecanique:rotation/plate"],
                tasks: [Item(item: "belt", count: 6)],
                rewards: [Xp(15)],
            ),
            (
                id: "mecanique:rotation/workshop",
                icon: "press",
                title: "Un atelier abandonné",
                text: "Quelque part sur les terres, un atelier de pierre garde une manivelle, des arbres, un engrenage et une presse déjà en ligne, avec un coffre. Va voir comment c'est monté.",
                x: 0.0, y: 7.5, shape: Pentagon,
                optional: true,
                after: ["mecanique:rotation/crank"],
                tasks: [Structure("mecanique:workshop")],
                rewards: [Xp(25)],
            ),
            (
                id: "mecanique:rotation/gate",
                title: "Le portail de la Fonderie",
                text: "Huit plaques de fer autour d'une pierre lumineuse. Les pierres lumineuses éclairent les cryptes du mod Donjons : casses-en une. Tiens-toi dans le portail une seconde et demie.",
                x: 10.0, y: 6.25, shape: Square,
                optional: true,
                after: ["mecanique:rotation/plate", "donjons:crypte/light"],
                tasks: [Item(item: "gate")],
                rewards: [Xp(25)],
            ),
            (
                id: "mecanique:rotation/foundry",
                icon: "gate",
                title: "La Fonderie",
                text: "Un désert sous un ciel rougeâtre, où la gravité est plus légère. Un portail de retour t'attend à l'arrivée.",
                x: 13.0, y: 6.25, shape: Hexagon, size: 1.5,
                optional: true,
                after: ["mecanique:rotation/gate"],
                tasks: [Dimension("mecanique:foundry")],
                rewards: [Xp(40)],
            ),
        ],
    )],
)
