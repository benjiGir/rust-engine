// Les blocs de Mécanique. Les arbres et engrenages sont des **conduits** de rotation : le jeu
// relie ceux qui se touchent en un réseau (`conduit: Kinetic`). Leurs formes sont des boîtes,
// et `states: [Axis]` leur donne les trois orientations (posés selon la face visée).
[
    (
        id: "mecanique:shaft", name: "Arbre de transmission", color: (0.2106, 0.1693, 0.1296), texture: "shaft",
        boxes: [(from: (6, 0, 6), to: (10, 16, 10))], states: [Axis], conduit: Kinetic,
        // Rotation décorative continue (rad/s), indépendante du réseau cinétique.
        rotation: (axis: Y, speed: 1.5),
        hardness: 1.0, tool: Axe,
        sounds: (step: "core:step_hard", break: "core:break_hard", place: "core:place_hard"),
    ),
    (
        id: "mecanique:gear", name: "Engrenage", color: (0.2599, 0.1304, 0.0814), texture: "gear",
        boxes: [
            (from: (6, 0, 6), to: (10, 16, 10)),
            (from: (3, 6, 3), to: (13, 10, 13)),
            (from: (0, 6, 5), to: (3, 10, 8)),
            (from: (0, 6, 9), to: (3, 10, 12)),
            (from: (13, 6, 4), to: (16, 10, 7)),
            (from: (13, 6, 8), to: (16, 10, 11)),
            (from: (4, 6, 0), to: (7, 10, 3)),
            (from: (8, 6, 0), to: (11, 10, 3)),
            (from: (5, 6, 13), to: (8, 10, 16)),
            (from: (9, 6, 13), to: (12, 10, 16)),
        ],
        states: [Axis], conduit: Kinetic,
        rotation: (axis: Y, speed: 1.5),
        hardness: 1.5, tool: Pickaxe,
        sounds: (step: "core:step_hard", break: "core:break_hard", place: "core:place_hard"),
    ),
    // Un portail : le joueur qui s'y tient 1,5 seconde passe dans la dimension `portal` (voir
    // dimensions.ron). Il ne bloque pas le passage (`solid: false`) ; sa surface est translucide.
    (
        id: "mecanique:gate", name: "Portail de la Fonderie", color: (0.3788, 0.1566, 0.0740), texture: "gate",
        boxes: [(from: (0, 0, 6), to: (2, 16, 10)), (from: (14, 0, 6), to: (16, 16, 10)),
                (from: (2, 14, 6), to: (14, 16, 10)), (from: (2, 0, 7.5), to: (14, 14, 8.5))],
        solid: false, alpha: 0.8, light_emission: 9, portal: "mecanique:foundry",
        hardness: 1.0, tool: Pickaxe,
        sounds: (step: "core:step_hard", break: "core:break_glass", place: "core:place_hard"),
    ),
    // Le portail de retour, posé par le jeu à l'arrivée dans la Fonderie.
    (
        id: "mecanique:return_gate", name: "Portail du retour", color: (0.0814, 0.1630, 0.2836), texture: "return_gate",
        boxes: [(from: (0, 0, 6), to: (2, 16, 10)), (from: (14, 0, 6), to: (16, 16, 10)),
                (from: (2, 14, 6), to: (14, 16, 10)), (from: (2, 0, 7.5), to: (14, 14, 8.5))],
        solid: false, alpha: 0.8, light_emission: 9, portal: "core:overworld", placeable: false,
        hardness: 1.0, tool: Pickaxe,
        sounds: (step: "core:step_hard", break: "core:break_glass", place: "core:place_hard"),
    ),
    // Une courroie : un conduit d'**objets** (`conduit: Items`). Elle relie les inventaires qui la
    // touchent : les machines rendent par leurs sorties, reçoivent dans leurs entrées, et les
    // coffres servent de tampon. `channel` sépare les réseaux (des courroies d'un autre canal ne
    // s'y relient pas) ; `throughput` plafonne le débit du réseau (objets par passage).
    (
        id: "mecanique:belt", name: "Courroie", color: (0.1415, 0.0722, 0.0567), texture: "belt",
        boxes: [
            (from: (0, 2, 1), to: (16, 4, 15)),
            (from: (1, 0, 2), to: (4, 2, 14)),
            (from: (12, 0, 2), to: (15, 2, 14)),
        ], conduit: Items, channel: "belt",
        hardness: 0.8, tool: Pickaxe,
        sounds: (step: "core:step_hard", break: "core:break_hard", place: "core:place_hard"),
    ),
    // Une source : un clic droit la fait tourner quelques secondes.
    (
        id: "mecanique:crank", name: "Manivelle", color: (0.1214, 0.1068, 0.1156), texture: "crank",
        boxes: [
            (from: (2, 0, 2), to: (14, 3, 14)),
            (from: (6, 3, 6), to: (10, 9, 10)),
            (from: (7, 9, 7), to: (9, 11, 14)),
            (from: (6, 11, 12), to: (10, 16, 15)),
        ],
        behavior: "crank", hardness: 1.5, tool: Pickaxe,
        sounds: (step: "core:step_hard", break: "core:break_hard", place: "core:place_hard"),
    ),
    // Une machine : elle consomme de la rotation pour transformer ce qu'on met dedans.
    (
        id: "mecanique:press", name: "Presse", color: (0.1657, 0.1442, 0.1462), texture: "press",
        boxes: [
            (from: (0, 0, 0), to: (16, 3, 16)),
            (from: (1, 3, 2), to: (4, 14, 14)),
            (from: (12, 3, 2), to: (15, 14, 14)),
            (from: (0, 14, 0), to: (16, 16, 16)),
            (from: (6, 10, 6), to: (10, 14, 10)),
            (from: (4, 8, 4), to: (12, 10, 12)),
            (from: (4, 3, 4), to: (12, 4, 12)),
        ],
        behavior: "press", hardness: 2.0, tool: Pickaxe,
        // Pour les courroies : la case 0 reçoit (seulement ce que ses recettes consomment), la
        // case 1 rend.
        ports: (inputs: [0], outputs: [1], accepts: "press"),
        sounds: (step: "core:step_hard", break: "core:break_hard", place: "core:place_hard"),
    ),
    // Un convoyeur : une courroie **à sens unique** (`flow: true`). Il pointe où regarde le joueur
    // (la flèche), prend les objets par l'arrière et les côtés, et ne les rend que par l'avant.
    // Il se relie aux courroies ordinaires du même canal.
    (
        id: "mecanique:conveyor", name: "Convoyeur", color: (0.1415, 0.0722, 0.0567), texture: "belt",
        boxes: [
            (from: (0, 0, 0), to: (16, 3, 16)),
            (from: (0, 3, 0), to: (2, 5, 16)),
            (from: (14, 3, 0), to: (16, 5, 16)),
            (from: (7, 3, 8), to: (9, 6, 14)),
            (from: (3, 3, 6), to: (13, 6, 8)),
            (from: (5, 3, 4), to: (11, 6, 6)),
            (from: (7, 3, 2), to: (9, 6, 4)),
        ], states: [Facing4], conduit: Items, channel: "belt", flow: true,
        hardness: 0.8, tool: Pickaxe,
        sounds: (step: "core:step_hard", break: "core:break_hard", place: "core:place_hard"),
    ),
    // Une diode : un conduit d'**énergie** à sens unique. L'énergie ne va que vers la flèche ; une
    // batterie ou un générateur derrière elle alimente ce qui est devant, jamais l'inverse. Elle
    // se relie aux câbles du jeu.
    (
        id: "mecanique:diode", name: "Diode", color: (0.1822, 0.0835, 0.0492), texture: "core:cable",
        boxes: [
            (from: (4, 0, 0), to: (12, 4, 16)),
            (from: (7, 4, 9), to: (9, 7, 15)),
            (from: (4, 4, 7), to: (12, 7, 9)),
            (from: (6, 4, 5), to: (10, 7, 7)),
            (from: (7, 4, 3), to: (9, 7, 5)),
        ], states: [Facing4], conduit: Energy, flow: true,
        hardness: 1.0, tool: Pickaxe,
        sounds: (step: "core:step_hard", break: "core:break_hard", place: "core:place_hard"),
    ),
    // Un clapet anti-retour : un conduit de **fluide** à sens unique, relié aux tuyaux du jeu.
    (
        id: "mecanique:check_valve", name: "Clapet anti-retour", color: (0.1, 0.18, 0.3), texture: "core:pipe",
        boxes: [
            (from: (4, 0, 0), to: (12, 8, 16)),
            (from: (7, 8, 9), to: (9, 11, 15)),
            (from: (4, 8, 7), to: (12, 11, 9)),
            (from: (6, 8, 5), to: (10, 11, 7)),
            (from: (7, 8, 3), to: (9, 11, 5)),
        ], states: [Facing4], conduit: Fluid, flow: true,
        hardness: 1.0, tool: Pickaxe,
        sounds: (step: "core:step_hard", break: "core:break_hard", place: "core:place_hard"),
    ),
]
