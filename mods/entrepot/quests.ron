// Le chapitre de l'entrepôt dans le livre de quêtes (voir assets/core/quests.ron et docs/modding.md).
(
    chapters: [(
        id: "entrepot:automation",
        group: "core:mods",
        title: "L'entrepôt",
        icon: "vault",
        quests: [
            (
                id: "entrepot:automation/vault",
                title: "Un grand coffre",
                subtitle: "Cinquante-quatre cases",
                text: "Un coffre entouré de huit planches. Son bouton « Ranger » regroupe les piles et trie le contenu ; il sert aussi de tampon aux conduits d'objets.",
                x: 0.0, y: 3.75, shape: Square,
                after: ["core:storage/copper_kit"],
                tasks: [Item(item: "vault")],
                rewards: [Xp(15)],
            ),
            (
                id: "entrepot:automation/sorter",
                title: "Un trieur",
                text: "Un coffre entouré de huit lingots de fer. Pose un exemplaire de l'objet voulu dans sa case modèle : seul cet objet entre par les conduits.",
                x: 3.0, y: 0.0, shape: Diamond,
                after: ["entrepot:automation/vault"],
                tasks: [Item(item: "sorter")],
                rewards: [Xp(15)],
            ),
            (
                id: "entrepot:automation/harvester",
                title: "Une moissonneuse",
                subtitle: "Un champ qui se récolte seul",
                text: "Elle récolte les cultures mûres autour d'elle (au même niveau, à trois blocs) et les replante, puis garde la récolte dans ses neuf cases. Pose-la au milieu de ton champ.",
                x: 3.0, y: 3.75, shape: Hexagon, size: 2.0,
                after: ["entrepot:automation/vault", "core:food/field"],
                tasks: [Item(item: "harvester")],
                rewards: [Item(item: "core:seeds", count: 8), Xp(25)],
            ),
            (
                id: "entrepot:automation/drill",
                title: "Une foreuse",
                text: "Sept lingots de fer, une pioche en fer et un coffre. Alimentée (un levier voisin suffit), elle creuse un puits droit sous elle, un bloc par seconde, jusqu'à 48 blocs, et garde ce qu'elle trouve.",
                x: 3.0, y: 7.5, shape: Pentagon,
                after: ["entrepot:automation/vault", "core:circuits/lever"],
                tasks: [Item(item: "drill")],
                rewards: [Xp(25)],
            ),
            (
                id: "entrepot:automation/chain",
                icon: "vault",
                title: "Une chaîne qui travaille",
                text: "Relie la moissonneuse à un grand coffre par des conduits d'objets (les courroies du mod Mécanique en sont) : la récolte s'y range sans toi, et le trieur ne laisse passer que ce que tu veux. Coche la case quand ça tourne.",
                x: 7.0, y: 3.75, shape: RoundSquare,
                after: ["entrepot:automation/harvester", "entrepot:automation/sorter", "mecanique:rotation/belt"],
                tasks: [Check],
                rewards: [Xp(30)],
            ),
        ],
    )],
)
