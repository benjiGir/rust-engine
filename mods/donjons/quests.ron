// Le chapitre de la crypte dans le livre de quêtes (voir assets/core/quests.ron et docs/modding.md).
(
    chapters: [(
        id: "donjons:crypte",
        group: "core:mods",
        title: "La crypte",
        icon: "warden_sigil",
        quests: [
            (
                id: "donjons:crypte/crypt",
                icon: "crypt_brick",
                title: "Une crypte",
                subtitle: "Un escalier, et le noir",
                text: "Enterrée sous les terres, une crypte relie ses salles en réseau : couloirs, pièges à pointes, cages à gardiens, et un gardien tout au fond. Un escalier la relie à la surface. Viens en armure.",
                x: 0.0, y: 3.75, shape: Hexagon, size: 2.0,
                after: ["core:combat/armor"],
                tasks: [Structure("donjons:crypt")],
                rewards: [Item(item: "core:torch", count: 12), Xp(25)],
            ),
            (
                id: "donjons:crypte/light",
                icon: "core:glowstone",
                title: "De la lumière",
                text: "Un bloc de pierre lumineuse est incrusté dans le toit des couloirs. Casses-en deux : on en fait des lampes, et un portail pour un autre mod.",
                x: 3.5, y: 0.0, shape: Diamond,
                after: ["donjons:crypte/crypt"],
                tasks: [Item(item: "core:glowstone", count: 2)],
                rewards: [Xp(15)],
            ),
            (
                id: "donjons:crypte/guards",
                icon: "core:shadow_dust",
                title: "Les gardiens",
                text: "Une cage à gardiens fait surgir des rôdeurs quand tu approches, puis disparaît. Frappe-les un par un.",
                x: 3.5, y: 3.75,
                after: ["donjons:crypte/crypt"],
                tasks: [Kill(creature: "core:prowler", count: 5)],
                rewards: [Xp(25)],
            ),
            (
                id: "donjons:crypte/treasure",
                icon: "core:gold_ingot",
                title: "Une salle du trésor",
                text: "Au bout d'une branche de la crypte, une salle garde deux coffres bien remplis. Ouvre-les et coche la case.",
                x: 3.5, y: 7.5, shape: Square,
                after: ["donjons:crypte/crypt"],
                tasks: [Check],
                rewards: [Xp(25)],
            ),
            (
                id: "donjons:crypte/warden",
                icon: "warden_sigil",
                title: "Le gardien de la crypte",
                subtitle: "Le boss",
                text: "Dans la salle la plus profonde, 80 points de vie, une charge brutale et des renforts à mi-vie. Prépare ta meilleure armure, des potions de soin et de la place pour reculer.",
                x: 7.5, y: 3.75, shape: Hexagon, size: 2.0,
                after: ["donjons:crypte/guards"],
                tasks: [Kill(creature: "donjons:warden")],
                rewards: [Item(item: "core:bread", count: 6), Xp(60)],
            ),
            (
                id: "donjons:crypte/sigil",
                title: "Le sceau du gardien",
                text: "Il le laisse en tombant, avec de l'or. Garde-le : un trophée qui prouve que la crypte est à toi.",
                x: 11.0, y: 1.25, shape: Diamond,
                after: ["donjons:crypte/warden"],
                tasks: [Item(item: "warden_sigil")],
                rewards: [Xp(25)],
            ),
            (
                id: "donjons:crypte/summit",
                icon: "core:iron_chestplate",
                title: "Le Sommet",
                text: "Un boss vaincu et deux cent cinquante hostiles tuées ouvrent le palier Sommet : les élites sont nombreuses, les envahisseurs reviennent plus vite. {touche:tiers} ouvre l'écran des paliers.",
                x: 11.0, y: 6.25, shape: Pentagon, size: 1.5,
                after: ["donjons:crypte/warden"],
                tasks: [Tier(3)],
                rewards: [Item(item: "core:bread", count: 8), Xp(50)],
            ),
        ],
    )],
)
