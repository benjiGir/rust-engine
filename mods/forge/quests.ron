// Le chapitre de la forge dans le livre de quêtes (voir assets/core/quests.ron et docs/modding.md).
// Un nom d'objet sans « : » est celui du mod ; ceux du jeu de base s'écrivent en entier (`core:...`).
(
    chapters: [(
        id: "forge:forge",
        group: "core:mods",
        title: "La forge",
        icon: "steel_ingot",
        quests: [
            (
                id: "forge:forge/alloy_furnace",
                title: "Un four à alliages",
                subtitle: "Mêler les métaux",
                text: "Huit moellons autour d'un four. Il a trois cases d'entrée, une case de combustible (du charbon) et une sortie : c'est lui qui fait l'acier et le bronze.",
                x: 0.0, y: 3.75, shape: Hexagon, size: 1.5,
                after: ["core:metal/ingot"],
                tasks: [Item(item: "alloy_furnace")],
                rewards: [Item(item: "core:coal", count: 8), Xp(15)],
            ),
            (
                id: "forge:forge/steel",
                title: "De l'acier",
                text: "Deux lingots de fer et un charbon donnent un lingot d'acier, en dix secondes. Une tête de pioche en demande trois : prépare-en plusieurs.",
                x: 3.0, y: 0.0,
                after: ["forge:forge/alloy_furnace"],
                tasks: [Item(item: "steel_ingot", count: 4)],
                rewards: [Xp(15)],
            ),
            (
                id: "forge:forge/bronze",
                title: "Du bronze",
                text: "Trois lingots de cuivre et un morceau de malachite donnent trois lingots de bronze. La malachite se trouve sous la hauteur 40, ou s'obtient en cuisant un cactus.",
                x: 3.0, y: 5.0, shape: RoundSquare,
                after: ["forge:forge/alloy_furnace"],
                tasks: [Item(item: "bronze_ingot", count: 3)],
                rewards: [Xp(15)],
            ),
            (
                id: "forge:forge/hammer",
                title: "Un marteau de bronze",
                text: "Trois lingots de bronze et deux bâtons. L'enclume ne forge rien sans lui, et il s'use à chaque coup : 200 usages.",
                x: 6.0, y: 5.0, shape: Diamond,
                after: ["forge:forge/bronze"],
                tasks: [Item(item: "bronze_hammer")],
                rewards: [Xp(15)],
            ),
            (
                id: "forge:forge/anvil",
                title: "Une enclume",
                text: "Sept lingots de fer : une rangée de trois, un lingot au milieu, une autre rangée de trois. Un clic droit l'ouvre : le marteau dans sa case, de l'acier dans les autres, et un bouton par pièce à forger.",
                x: 6.0, y: 0.0, shape: Square,
                after: ["forge:forge/steel"],
                tasks: [Item(item: "anvil")],
                rewards: [Xp(15)],
            ),
            (
                id: "forge:forge/steel_pickaxe",
                title: "Une pioche en acier",
                subtitle: "Forger plutôt qu'assembler",
                text: "À l'enclume, trois lingots d'acier font une tête de pioche ; sur l'établi, elle se pose sur deux bâtons. Niveau 3 comme le fer, mais 700 usages au lieu de 250.",
                x: 9.5, y: 2.5, shape: Hexagon, size: 2.0,
                after: ["forge:forge/anvil", "forge:forge/hammer"],
                tasks: [Item(item: "steel_pickaxe")],
                rewards: [Item(item: "core:torch", count: 12), Xp(30)],
            ),
            (
                id: "forge:forge/steel_sword",
                title: "Une épée en acier",
                text: "Une lame (deux lingots d'acier, à l'enclume) au-dessus d'un bâton : 8,5 de dégâts, contre 8 pour l'épée en fer.",
                x: 13.0, y: 0.0, shape: Diamond,
                optional: true,
                after: ["forge:forge/steel_pickaxe"],
                tasks: [Item(item: "steel_sword")],
                rewards: [Xp(20)],
            ),
            (
                id: "forge:forge/steel_chestplate",
                title: "Un plastron en acier",
                text: "Huit plaques d'acier (deux lingots chacune, à l'enclume) en forme de plastron : la même protection que le fer, mais deux fois plus durable.",
                x: 13.0, y: 5.0, shape: Square,
                optional: true,
                after: ["forge:forge/steel_pickaxe"],
                tasks: [Item(item: "steel_chestplate")],
                rewards: [Xp(30)],
            ),
        ],
    )],
)
