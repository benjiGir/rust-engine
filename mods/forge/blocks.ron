// Les deux machines de la forge ; leur comportement est dans le script.
[
    // Le four à alliages : trois cases d'entrée, du combustible, une sortie. Il brûle du charbon.
    (
        id: "forge:alloy_furnace", name: "Four à alliages", color: (0.0738, 0.1097, 0.1281),
        boxes: [
            (from: (1, 0, 1), to: (5, 2, 5)),
            (from: (11, 0, 1), to: (15, 2, 5)),
            (from: (1, 0, 11), to: (5, 2, 15)),
            (from: (11, 0, 11), to: (15, 2, 15)),
            (from: (1, 2, 1), to: (15, 13, 15)),
            (from: (2, 13, 2), to: (14, 15, 14)),
            (from: (5, 15, 5), to: (11, 16, 11)),
        ],
        textures: (top: "alloy_furnace_top", side: "alloy_furnace_side", bottom: "alloy_furnace_top"),
        behavior: "alloy_furnace",
        // Un réseau d'objets remplit les trois entrées et vide la sortie (pas le combustible).
        ports: (inputs: [0, 1, 2], outputs: [4]),
        light_emission: 4,
        hardness: 3.0, tool: Pickaxe,
        sounds: (step: "core:step_metal", break: "core:break_metal", place: "core:place_metal"),
    ),
    // L'enclume : deux cases, un marteau, une sortie. On choisit la pièce à forger par un bouton.
    (
        id: "forge:anvil", name: "Enclume", color: (0.1428, 0.1820, 0.1885),
        textures: (top: "anvil_top", side: "anvil_side", bottom: "anvil_top"),
        behavior: "anvil",
        boxes: [
            (from: (1, 0, 3), to: (15, 3, 13)),
            (from: (3, 3, 4), to: (13, 5, 12)),
            (from: (6, 5, 5), to: (10, 10, 11)),
            (from: (3, 10, 3), to: (14, 13, 13)),
            (from: (4, 13, 3), to: (14, 15, 13)),
            (from: (1, 11, 5), to: (3, 14, 11)),
            (from: (0, 11, 6), to: (1, 13, 10)),
            (from: (14, 10, 5), to: (16, 13, 11)),
        ],
        hardness: 4.0, tool: Pickaxe,
        sounds: (step: "core:step_metal", break: "core:break_metal", place: "core:place_metal"),
    ),
]
