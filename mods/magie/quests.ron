// Le chapitre de la magie dans le livre de quêtes (voir assets/core/quests.ron et docs/modding.md).
(
    chapters: [(
        id: "magie:runes",
        group: "core:mods",
        title: "Les runes",
        icon: "mana_crystal",
        quests: [
            (
                id: "magie:runes/crystal",
                title: "Un cristal de mana",
                subtitle: "Un saphir, trois cristaux",
                text: "Un clic droit sur un cristal rend 40 de mana. La réserve se remplit aussi toute seule, et grandit avec ton niveau d'expérience.",
                x: 0.0, y: 3.75, shape: Hexagon, size: 1.5,
                after: ["core:depths/sapphire"],
                tasks: [Item(item: "mana_crystal", count: 3)],
                rewards: [Xp(15)],
            ),
            (
                id: "magie:runes/flame",
                title: "Une rune de flamme",
                text: "Un cristal et un charbon, côte à côte. Chaque rune d'effet (flamme, soin, saut) se fait ainsi : un cristal et un ingrédient.",
                x: 3.0, y: 0.0, shape: Diamond,
                after: ["magie:runes/crystal"],
                tasks: [Item(item: "rune_flame")],
                rewards: [Xp(10)],
            ),
            (
                id: "magie:runes/table",
                title: "Une table des runes",
                text: "Huit moellons autour d'un cristal. Un clic droit l'ouvre : pose une rune d'effet, jusqu'à deux modificateurs, et le bouton « Inscrire ce sort » le retient.",
                x: 3.0, y: 3.75, shape: Square,
                after: ["magie:runes/crystal"],
                tasks: [Item(item: "rune_table")],
                rewards: [Xp(10)],
            ),
            (
                id: "magie:runes/wand",
                title: "Une baguette",
                text: "Un cristal au-dessus de deux bâtons. Un clic droit avec elle lance le sort inscrit, contre du mana.",
                x: 3.0, y: 7.5, shape: RoundSquare,
                after: ["magie:runes/crystal"],
                tasks: [Item(item: "wand")],
                rewards: [Xp(10)],
            ),
            (
                id: "magie:runes/spell",
                icon: "rune_flame",
                title: "Un premier sort",
                subtitle: "Une flamme, là où tu vises",
                text: "Pose la rune de flamme sur la table, inscris le sort, puis lance-le d'un clic droit avec la baguette : une explosion de feu éclate à l'endroit visé. La quête se valide toute seule dès qu'un sort part.",
                x: 6.5, y: 3.75, shape: Hexagon, size: 2.0,
                after: ["magie:runes/flame", "magie:runes/table", "magie:runes/wand"],
                tasks: [Signal("spell_cast")],
                rewards: [Item(item: "magie:mana_crystal", count: 2), Xp(25)],
            ),
            (
                id: "magie:runes/heal",
                title: "Une rune de soin",
                text: "Un cristal et une pomme : le sort rend de la vie à son lanceur.",
                x: 10.0, y: 0.0, shape: Diamond,
                optional: true,
                after: ["magie:runes/spell"],
                tasks: [Item(item: "rune_heal")],
                rewards: [Xp(10)],
            ),
            (
                id: "magie:runes/blink",
                title: "Une rune de saut",
                text: "Un cristal et de la poussière d'ombre : le sort te transporte à l'endroit visé.",
                x: 10.0, y: 2.5, shape: Diamond,
                optional: true,
                after: ["magie:runes/spell"],
                tasks: [Item(item: "rune_blink")],
                rewards: [Xp(10)],
            ),
            (
                id: "magie:runes/boost",
                icon: "rune_power",
                title: "Renforcer un sort",
                text: "La puissance (un cristal et un lingot d'or) et la portée (un cristal et de la malachite) renforcent le sort inscrit ; chacune coûte du mana en plus.",
                x: 10.0, y: 5.0, shape: Pentagon,
                optional: true,
                after: ["magie:runes/spell"],
                tasks: [Item(item: "rune_power"), Item(item: "rune_reach")],
                rewards: [Xp(20)],
            ),
            (
                id: "magie:runes/level",
                icon: "mana_crystal",
                title: "Une plus grande réserve",
                text: "Le maximum de mana monte de 10 par niveau d'expérience. Au niveau 10, elle atteint 150.",
                x: 10.0, y: 7.5,
                optional: true,
                after: ["magie:runes/spell"],
                tasks: [Level(10)],
                rewards: [Item(item: "magie:mana_crystal", count: 3)],
            ),
        ],
    )],
)
