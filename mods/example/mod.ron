// Le manifeste du mod d'exemple. Voir docs/modding.md.
(
    id: "example",
    name: "Mod d'exemple",
    version: "1.0.0",
    authors: ["benji"],
    description: "Un rubis, un slime, et une machine qui casse les blocs.",
    // Le jeu de base, en version 0.1 ou plus récente (mais pas 1.0).
    dependencies: [(id: "core", version: "^0.1")],
    // Construit par `cargo run -p xtask -- build-mods` depuis `script/`.
    script: "example.wasm",
    // Une page d'options (menu pause) : `Mod::options` dans le script.
    options: true,
)
