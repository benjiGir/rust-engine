// Le catalogue de l'interface entre le jeu et les mods : la seule source de vérité.
//
// `cargo xtask hooks` en génère :
// - `crates/mod_sdk/src/ffi.rs` : les imports du mod (et leurs versions inertes hors
//   WebAssembly), et les numéros des événements et des appels de machines ;
// - `crates/engine_mods/src/runtime/abi.rs` : les mêmes numéros, côté jeu ;
// - les tableaux de l'interface binaire dans `docs/modding.md`.
// `cargo xtask hooks --check` (lancé par la CI) refuse un fichier généré pas à jour, et le
// test `host_matches_the_catalog` (engine_mods) vérifie que le jeu définit exactement ces
// fonctions, avec ces types.
//
// Ajouter une fonction : l'écrire ici, lancer `cargo xtask hooks`, puis la définir côté
// jeu (`engine_mods/src/runtime/host.rs`) et l'envelopper côté mod (`mod_sdk/src/host.rs`).
//
// `ret` : le type renvoyé, s'il y en a un. Types : I32, I64, F32, F64 (ce que WebAssembly sait passer). `fallback` : ce que la
// fonction renvoie hors WebAssembly (compilation native des mods, leurs tests).
#![enable(implicit_some)]
(
    module: "voxel",
    functions: [
        // Bases.
        (name: "log", group: "Bases",
         params: [("ptr", I32), ("len", I32)],
         doc: "Écrit le texte dans le journal du jeu, préfixé du nom du mod."),
        (name: "subscribe", group: "Bases",
         params: [("kind", I32)],
         doc: "S'abonne à un type d'événement (voir les événements) : `on_event` le recevra."),
        (name: "random", group: "Bases",
         params: [], ret: I32, fallback: "4",
         doc: "Un nombre pseudo-aléatoire positif (reproductible pour une même graine)."),
        (name: "give_item", group: "Bases",
         params: [("id", I32), ("count", I32)],
         doc: "Donne `count` objets du bloc `id` au joueur."),
        (name: "spawn_entity", group: "Bases",
         params: [("ptr", I32), ("len", I32), ("x", F32), ("y", F32), ("z", F32)],
         doc: "Fait apparaître une créature (identifiant texte, par exemple `core:pig`) à cette position."),

        // Blocs.
        (name: "block_id", group: "Blocs",
         params: [("ptr", I32), ("len", I32)], ret: I32, fallback: "-1",
         doc: "Le numéro d'un bloc à partir de son identifiant (`core:stone`) ; −1 s'il n'existe pas."),
        (name: "block_key", group: "Blocs",
         params: [("id", I32), ("ptr", I32), ("cap", I32)], ret: I32, fallback: "-1",
         doc: "L'identifiant texte d'un bloc (`core:stone`), écrit à `ptr` (au plus `cap` octets) ; renvoie sa taille, −1 si le bloc n'existe pas. C'est aussi le nom de l'objet qu'il donne en inventaire."),
        (name: "block_drops", group: "Blocs",
         params: [("id", I32), ("ptr", I32), ("cap", I32)], ret: I32, fallback: "-1",
         doc: "Ce que lâcherait ce bloc cassé : `objet*nombre;objet*nombre`, écrit à `ptr` (au plus `cap` octets) ; renvoie la taille (0 : rien), −1 si le bloc n'existe pas. Le hasard est tiré à chaque appel."),
        (name: "block_base", group: "Blocs",
         params: [("id", I32)], ret: I32, fallback: "0",
         doc: "Le bloc de base d'un bloc à états : `example:stairs[facing=east]` donne `example:stairs`. Un bloc ordinaire se renvoie lui-même."),
        (name: "get_block", group: "Blocs",
         params: [("g", I32), ("x", I32), ("y", I32), ("z", I32)], ret: I32, fallback: "0",
         doc: "Le bloc à cette position (0 : de l'air, ou une grille inconnue)."),
        (name: "set_block", group: "Blocs",
         params: [("g", I32), ("x", I32), ("y", I32), ("z", I32), ("id", I32)], ret: I32, fallback: "0",
         doc: "Pose un bloc ; les voisins sont prévenus. Si le bloc remplacé avait un inventaire (coffre, machine), son contenu tombe au sol. 1 si c'est fait."),
        (name: "get_power", group: "Blocs",
         params: [("g", I32), ("x", I32), ("y", I32), ("z", I32)], ret: I32, fallback: "0",
         doc: "La puissance émise par ce bloc (0 à 15)."),
        (name: "received_power", group: "Blocs",
         params: [("g", I32), ("x", I32), ("y", I32), ("z", I32)], ret: I32, fallback: "0",
         doc: "La plus forte puissance reçue des 6 voisins."),
        (name: "set_power", group: "Blocs",
         params: [("g", I32), ("x", I32), ("y", I32), ("z", I32), ("power", I32)], ret: I32, fallback: "0",
         doc: "Change la puissance émise (0 à 15) ; les voisins sont prévenus. 1 si c'est fait."),
        (name: "get_data", group: "Blocs",
         params: [("g", I32), ("x", I32), ("y", I32), ("z", I32), ("ptr", I32), ("cap", I32)], ret: I32, fallback: "-1",
         doc: "Copie l'état libre du bloc (au plus `cap` octets) ; renvoie sa taille, −1 sans état."),
        (name: "set_data", group: "Blocs",
         params: [("g", I32), ("x", I32), ("y", I32), ("z", I32), ("ptr", I32), ("len", I32)], ret: I32, fallback: "0",
         doc: "Remplace l'état libre du bloc, sauvegardé avec le monde. 1 si c'est fait."),
        (name: "schedule_tick", group: "Blocs",
         params: [("g", I32), ("x", I32), ("y", I32), ("z", I32), ("delay", I32)],
         doc: "Réveille la machine dans `delay` ticks (20 par seconde)."),

        // Capacités.
        (name: "add_energy", group: "Capacités",
         params: [("g", I32), ("x", I32), ("y", I32), ("z", I32), ("capacity", I64), ("rate", I64), ("sides", I32)], ret: I32, fallback: "0",
         doc: "Donne au bloc un stockage d'énergie, ouvert sur les faces `sides` (6 bits). 1 si c'est fait."),
        (name: "add_tank", group: "Capacités",
         params: [("g", I32), ("x", I32), ("y", I32), ("z", I32), ("capacity", I32), ("sides", I32)], ret: I32, fallback: "0",
         doc: "Ajoute un réservoir de `capacity` mB. 1 si c'est fait."),
        (name: "add_inventory", group: "Capacités",
         params: [("g", I32), ("x", I32), ("y", I32), ("z", I32), ("slots", I32), ("sides", I32)], ret: I32, fallback: "0",
         doc: "Donne au bloc un inventaire de `slots` cases. 1 si c'est fait."),
        (name: "add_kinetic", group: "Capacités",
         params: [("g", I32), ("x", I32), ("y", I32), ("z", I32), ("sides", I32)], ret: I32, fallback: "0",
         doc: "Donne au bloc une rotation (vitesse, capacité et consommation de contrainte). 1 si c'est fait."),
        (name: "energy_stored", group: "Capacités",
         params: [("g", I32), ("x", I32), ("y", I32), ("z", I32)], ret: I64, fallback: "-1",
         doc: "L'énergie stockée ; −1 sans stockage."),
        (name: "energy_insert", group: "Capacités",
         params: [("g", I32), ("x", I32), ("y", I32), ("z", I32), ("face", I32), ("amount", I64), ("simulate", I32)], ret: I64, fallback: "0",
         doc: "Insère de l'énergie par cette face ; renvoie la quantité acceptée."),
        (name: "energy_extract", group: "Capacités",
         params: [("g", I32), ("x", I32), ("y", I32), ("z", I32), ("face", I32), ("amount", I64), ("simulate", I32)], ret: I64, fallback: "0",
         doc: "Retire de l'énergie par cette face ; renvoie la quantité retirée."),
        (name: "fluid_amount", group: "Capacités",
         params: [("g", I32), ("x", I32), ("y", I32), ("z", I32), ("ptr", I32), ("len", I32)], ret: I32, fallback: "0",
         doc: "La quantité (mB) de ce fluide dans les réservoirs du bloc."),
        (name: "fluid_fill", group: "Capacités",
         params: [("g", I32), ("x", I32), ("y", I32), ("z", I32), ("face", I32), ("ptr", I32), ("len", I32), ("amount", I32), ("simulate", I32)], ret: I32, fallback: "0",
         doc: "Remplit avec ce fluide par cette face ; renvoie la quantité acceptée (mB)."),
        (name: "fluid_drain", group: "Capacités",
         params: [("g", I32), ("x", I32), ("y", I32), ("z", I32), ("face", I32), ("ptr", I32), ("len", I32), ("amount", I32), ("simulate", I32)], ret: I32, fallback: "0",
         doc: "Vide ce fluide par cette face ; renvoie la quantité retirée (mB)."),
        (name: "item_count", group: "Capacités",
         params: [("g", I32), ("x", I32), ("y", I32), ("z", I32), ("ptr", I32), ("len", I32)], ret: I32, fallback: "0",
         doc: "Le nombre de cet objet dans l'inventaire du bloc."),
        (name: "item_insert", group: "Capacités",
         params: [("g", I32), ("x", I32), ("y", I32), ("z", I32), ("face", I32), ("ptr", I32), ("len", I32), ("count", I32), ("simulate", I32)], ret: I32, fallback: "0",
         doc: "Range des objets par cette face ; renvoie le nombre accepté."),
        (name: "item_extract", group: "Capacités",
         params: [("g", I32), ("x", I32), ("y", I32), ("z", I32), ("face", I32), ("ptr", I32), ("len", I32), ("count", I32), ("simulate", I32)], ret: I32, fallback: "0",
         doc: "Sort des objets par cette face ; renvoie le nombre retiré."),
        (name: "slot_get", group: "Capacités",
         params: [("g", I32), ("x", I32), ("y", I32), ("z", I32), ("slot", I32), ("ptr", I32), ("cap", I32)], ret: I32, fallback: "-1",
         doc: "Lit une case de l'inventaire du bloc : écrit `objet*nombre` (au plus `cap` octets) et renvoie la taille ; −1 si la case est vide ou n'existe pas."),
        (name: "slot_set", group: "Capacités",
         params: [("g", I32), ("x", I32), ("y", I32), ("z", I32), ("slot", I32), ("ptr", I32), ("len", I32)], ret: I32, fallback: "0",
         doc: "Remplace une case de l'inventaire par `objet*nombre` (texte vide : la vider). 1 si c'est fait."),
        (name: "slot_damage", group: "Capacités",
         params: [("g", I32), ("x", I32), ("y", I32), ("z", I32), ("slot", I32)], ret: I32, fallback: "-1",
         doc: "L'usure de l'objet dans cette case (0 : neuf, l'objet casse quand elle atteint sa durabilité) ; −1 si la case est vide ou n'existe pas."),
        (name: "slot_set_damage", group: "Capacités",
         params: [("g", I32), ("x", I32), ("y", I32), ("z", I32), ("slot", I32), ("damage", I32)], ret: I32, fallback: "0",
         doc: "Règle l'usure de l'objet dans cette case. 1 si c'est fait ; 0 si la case est vide ou n'existe pas. `slot_set` remet l'usure à 0."),
        (name: "kinetic_speed", group: "Capacités",
         params: [("g", I32), ("x", I32), ("y", I32), ("z", I32)], ret: F32, fallback: "0.0",
         doc: "La vitesse de rotation (tr/min, signée)."),
        (name: "set_kinetic", group: "Capacités",
         params: [("g", I32), ("x", I32), ("y", I32), ("z", I32), ("speed", F32), ("capacity", F32), ("impact", F32)], ret: I32, fallback: "0",
         doc: "Règle la vitesse, la capacité et la consommation de contrainte. 1 si c'est fait."),

        // Interface.
        (name: "ui_show", group: "Interface",
         params: [("g", I32), ("x", I32), ("y", I32), ("z", I32), ("ptr", I32), ("len", I32)],
         doc: "Ouvre (ou met à jour) le menu de la machine à cette position : `len` octets décrivant le menu (voir `Menu`). Le joueur le voit à l'écran."),
        (name: "ui_close", group: "Interface",
         params: [],
         doc: "Ferme le menu du mod s'il est ouvert."),

        (name: "options_show", group: "Interface",
         params: [("ptr", I32), ("len", I32)],
         doc: "Affiche (ou met à jour) la page d'options du mod : `len` octets décrivant le menu."),

        // Réglages.
        (name: "setting_get", group: "Réglages",
         params: [("key_ptr", I32), ("key_len", I32), ("out_ptr", I32), ("cap", I32)], ret: I32, fallback: "-1",
         doc: "Copie la valeur (texte) du réglage du mod (au plus `cap` octets) ; renvoie sa taille, −1 s'il n'existe pas."),
        (name: "setting_set", group: "Réglages",
         params: [("key_ptr", I32), ("key_len", I32), ("val_ptr", I32), ("val_len", I32)], ret: I32, fallback: "0",
         doc: "Enregistre un réglage du mod (clé de 64 octets, valeur de 1 024, 256 clés au plus). 1 si c'est fait."),

        (name: "world_get", group: "Réglages",
         params: [("key_ptr", I32), ("key_len", I32), ("out_ptr", I32), ("cap", I32)], ret: I32, fallback: "-1",
         doc: "Copie la valeur (texte) d'une donnée du mod **dans ce monde** (au plus `cap` octets) ; renvoie sa taille, −1 si elle n'existe pas."),
        (name: "world_set", group: "Réglages",
         params: [("key_ptr", I32), ("key_len", I32), ("val_ptr", I32), ("val_len", I32)], ret: I32, fallback: "0",
         doc: "Enregistre une donnée du mod dans ce monde (clé de 64 octets, valeur de 64 Kio, 1 024 clés au plus), sauvegardée avec le monde. 1 si c'est fait."),

        // Créatures à comportement.
        (name: "mob_kind", group: "Créatures",
         params: [("ptr", I32), ("len", I32)], ret: I32, fallback: "-1",
         doc: "Le numéro d'un type de créature (`example:guard`) tel que le montrent les créatures reçues dans `on_mobs` ; −1 s'il n'existe pas."),
        (name: "mob_move", group: "Créatures",
         params: [("mob", I32), ("dx", F32), ("dz", F32), ("speed", F32)],
         doc: "Pendant `on_mobs` : la créature marche dans la direction (dx, dz) à `speed` blocs par seconde (au plus le double de sa vitesse de base) ; elle se tourne vers là. Une vitesse nulle l'arrête. Valable jusqu'au prochain appel."),
        (name: "mob_jump", group: "Créatures",
         params: [("mob", I32)],
         doc: "Pendant `on_mobs` : la créature saute (si elle touche le sol)."),
        (name: "mob_attack", group: "Créatures",
         params: [("mob", I32), ("damage", F32)],
         doc: "Pendant `on_mobs` : la créature blesse le joueur s'il est à portée de bras (3 blocs) et si elle n'a pas frappé depuis une seconde."),
        (name: "mob_state", group: "Créatures",
         params: [("mob", I32), ("value", I32)],
         doc: "Pendant `on_mobs` : la mémoire de la créature (un entier de votre choix, rendu dans `state` au prochain appel)."),

        // Le joueur.
        (name: "player_info", group: "Joueur",
         params: [("out_ptr", I32), ("cap", I32)], ret: I32, fallback: "0",
         doc: "Écrit l'état du joueur : 9 décimaux (f32) `x, y, z` (ses yeux), `dx, dy, dz` (le regard, de longueur 1), `vie, vie max, niveau` ; renvoie leur nombre (0 s'il n'y a pas de joueur)."),
        (name: "player_target", group: "Joueur",
         params: [("max_dist", F32), ("out_ptr", I32)], ret: I32, fallback: "0",
         doc: "Lance un rayon dans la direction du regard : si un bloc est touché à moins de `max_dist` blocs, écrit le point d'impact (3 f32) et renvoie 1 ; sinon 0."),
        (name: "player_heal", group: "Joueur",
         params: [("amount", F32)],
         doc: "Rend de la vie au joueur."),
        (name: "player_teleport", group: "Joueur",
         params: [("x", F32), ("y", F32), ("z", F32)],
         doc: "Téléporte le joueur (les pieds en x, y, z), à 64 blocs au plus de là où il est."),
        (name: "player_effect", group: "Joueur",
         params: [("ptr", I32), ("len", I32), ("seconds", F32), ("power", F32)],
         doc: "Donne un effet au joueur : `speed`, `strength`, `regeneration`, `fire_resistance` ou `healing`."),
        (name: "hurt_area", group: "Joueur",
         params: [("x", F32), ("y", F32), ("z", F32), ("radius", F32), ("damage", F32)],
         doc: "Blesse les créatures à moins de `radius` blocs de ce point (jusqu'à 16 blocs) ; elles reculent."),
        (name: "say", group: "Joueur",
         params: [("ptr", I32), ("len", I32)],
         doc: "Écrit une ligne dans la console du joueur (un message : « pas assez de mana »)."),
        (name: "consume_held", group: "Joueur",
         params: [("count", I32)],
         doc: "Retire `count` exemplaires de l'objet que le joueur tient en main (une potion qu'on boit, un cristal qu'on use)."),
        (name: "hurt_player", group: "Joueur",
         params: [("amount", F32)],
         doc: "Blesse le joueur (l'armure et l'invulnérabilité après un coup comptent, comme pour une créature) : un piège, une explosion, une malédiction."),
        (name: "hud_bar", group: "Joueur",
         params: [("id", I32), ("fraction", F32), ("r", F32), ("g", F32), ("b", F32), ("ptr", I32), ("len", I32)],
         doc: "Affiche (ou met à jour) une jauge du mod à l'écran : `fraction` de 0 à 1, couleur (r, g, b) de 0 à 1, et son texte. Quatre jauges au plus par mod."),
        (name: "hud_clear", group: "Joueur",
         params: [("id", I32)],
         doc: "Retire une jauge du mod de l'écran."),

        // Dimensions.
        (name: "travel_to", group: "Dimensions",
         params: [("ptr", I32), ("len", I32)], ret: I32, fallback: "0",
         doc: "Fait passer le joueur dans cette dimension (`mon_mod:ma_dimension`) : le monde est sauvegardé puis rechargé, et le joueur arrive au sol aux mêmes x et z. 1 si le voyage est lancé, 0 si la dimension est inconnue ou si le monde n'est pas sauvegardé."),
        (name: "dimension", group: "Dimensions",
         params: [("out_ptr", I32), ("cap", I32)], ret: I32, fallback: "-1",
         doc: "Copie l'identifiant de la dimension où se trouve le joueur (`core:overworld`, `mon_mod:ma_dimension`) ; renvoie sa taille."),

        // Commandes.
        (name: "register_command", group: "Commandes",
         params: [("name_ptr", I32), ("name_len", I32), ("help_ptr", I32), ("help_len", I32)],
         doc: "Déclare la commande `/nom` du mod (à appeler dans `init`) avec sa ligne d'aide : le joueur la tape dans la console, et le mod la reçoit dans `on_command`."),

        // Appels entre mods.
        (name: "call_mod", group: "Appels entre mods",
         params: [("mod_ptr", I32), ("mod_len", I32), ("name_ptr", I32), ("name_len", I32), ("arg_ptr", I32), ("arg_len", I32), ("out_ptr", I32), ("cap", I32)], ret: I32, fallback: "-1",
         doc: "Appelle la fonction `name` du mod `mod` avec ces octets (64 Kio au plus) ; copie sa réponse (au plus `cap` octets) et renvoie sa taille. −1 si le mod est absent, désactivé, hors budget, déjà en cours d'appel (pas de cycle) ou s'il ne répond pas."),
        (name: "mod_loaded", group: "Appels entre mods",
         params: [("ptr", I32), ("len", I32)], ret: I32, fallback: "0",
         doc: "1 si le mod (son identifiant) est chargé et actif."),

        // Objets et recettes.
        (name: "item_id", group: "Objets et recettes",
         params: [("ptr", I32), ("len", I32)], ret: I32, fallback: "-1",
         doc: "Le numéro d'un objet (bloc ou non) à partir de son identifiant (`example:ruby`) ; −1 s'il n'existe pas."),
        (name: "item_max_stack", group: "Objets et recettes",
         params: [("ptr", I32), ("len", I32)], ret: I32, fallback: "0",
         doc: "Combien d'exemplaires de cet objet tiennent dans une case (1 pour un outil) ; 0 s'il n'existe pas."),
        (name: "item_durability", group: "Objets et recettes",
         params: [("ptr", I32), ("len", I32)], ret: I32, fallback: "0",
         doc: "Le nombre d'utilisations d'un objet avant qu'il casse (outils, armures) ; 0 s'il n'use pas ou n'existe pas."),
        (name: "give_stack", group: "Objets et recettes",
         params: [("id", I32), ("count", I32)],
         doc: "Donne `count` objets de numéro `id` (voir `item_id`) au joueur."),
        (name: "recipe_find", group: "Objets et recettes",
         params: [("kind_ptr", I32), ("kind_len", I32), ("in_ptr", I32), ("in_len", I32), ("out_ptr", I32), ("out_cap", I32)], ret: I32, fallback: "-1",
         doc: "Cherche une recette du type donné (`example:press`) faisable avec les objets `cle*nombre,cle*nombre` de l'entrée. Écrit `ticks;énergie;entrées;sorties` (même format) dans la sortie ; renvoie sa taille, −1 sans recette."),
    ],
    events: [
        (id: 1, name: "BlockBroken", constant: "BLOCK_BROKEN",
         data: "`grille, x, y, z, bloc` (i32)", doc: "un bloc a été cassé"),
        (id: 2, name: "BlockPlaced", constant: "BLOCK_PLACED",
         data: "`grille, x, y, z, bloc, dx, dy, dz` (i32 ; `d` : direction horizontale du regard du joueur)",
         doc: "un bloc a été posé"),
        (id: 3, name: "EntityDied", constant: "ENTITY_DIED",
         data: "`x, y, z` (f32), puis le type de créature en UTF-8", doc: "une créature est morte"),
        (id: 4, name: "Tick", constant: "TICK",
         data: "le numéro du tick (u64)", doc: "un tick de machines (20 par seconde)"),
        (id: 5, name: "PlayerDamaged", constant: "PLAYER_DAMAGED",
         data: "`dégâts, vie restante` (f32)", doc: "le joueur a perdu de la vie"),
        (id: 7, name: "ItemUsed", constant: "ITEM_USED",
         data: "`objet` (i32 : son numéro, voir `item_id`)",
         doc: "le joueur a fait un clic droit avec un objet `usable` en main (hors d'une action du jeu : poser un bloc, ouvrir un coffre...)"),
        (id: 6, name: "ChunkGenerated", constant: "CHUNK_GENERATED",
         data: "`grille, cx, cy, cz` (i32 ; coordonnées de chunk, 32 blocs de côté)",
         doc: "un chunk non vide vient d'être généré pour la première fois (pas relu d'une sauvegarde) : le mod peut le décorer"),
    ],
    machine_calls: [
        (id: 0, name: "Placed", constant: "PLACED", doc: "elles viennent d'être posées"),
        (id: 1, name: "Loaded", constant: "LOADED",
         doc: "leur chunk vient d'être chargé (les ticks programmés ne sont pas sauvegardés)"),
        (id: 2, name: "NeighborChanged", constant: "NEIGHBOR", doc: "un voisin a changé"),
        (id: 3, name: "ScheduledTick", constant: "TICK", doc: "leur tick programmé est arrivé"),
    ],
)
