+    if width < 200.0 {
+        add(ui, InventorySection::Armor);
+        ui.separator();
+        add(ui, InventorySection::Craft);
+        ui.collapsing("Recettes", |ui| add(ui, InventorySection::Recipes));
+    } else {
+        ui.horizontal_top(|ui| {
+            ui.vertical(|ui| {
+                ui.set_width((width * 0.37).min(118.0));
+                add(ui, InventorySection::Armor);
+            });
+            ui.vertical(|ui| {
+                ui.label("Artisanat");
+                add(ui, InventorySection::Craft);
+                ui.add_space(6.0);
+                ui.collapsing("Recettes", |ui| add(ui, InventorySection::Recipes));
+            });
+        });
+    }
 }
 
